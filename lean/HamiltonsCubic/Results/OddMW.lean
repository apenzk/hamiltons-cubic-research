theorem side_slope0 (t : ℕ) :
    To ((t : ℝ) + 7) / 2 * bt0 ((t : ℝ) + 7) ≤ Tn ((t : ℝ) + 7) / al2 ((t : ℝ) + 7) * (((t : ℝ) + 6) / ((t : ℝ) + 7)) := by
  set m : ℝ := (t : ℝ) + 7 with hm
  have hT0 : (0 : ℝ) ≤ t := t.cast_nonneg
