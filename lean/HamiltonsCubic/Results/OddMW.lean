theorem closeC_eq (m S : ℝ) (hm : 7 ≤ m) (hS : 0 < S) (hq : 0 < quad0P m S) :
    C0 m - (S * psit m ((1 - S) / S) + PhiRest m S (S ^ 2 / m))
