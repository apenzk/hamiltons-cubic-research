/-- The difference quotient of `ggo`, over the two denominators. -/
theorem ggo_diff (m S s s0 : ℝ) (h : alo m S - beo m S * s ≠ 0) (h0 : alo m S - beo m S * s0 ≠ 0) :
    ggo m S s - ggo m S s0 - kapo m * (s - s0)
      = (s - s0) * ellx m S s s0 / ((alo m S - beo m S * s) * (alo m S - beo m S * s0)) := by
  have k1 : (alo m S - beo m S * s) * (alo m S - beo m S * s)⁻¹ = 1 := mul_inv_cancel₀ h
  have k0 : (alo m S - beo m S * s0) * (alo m S - beo m S * s0)⁻¹ = 1 := mul_inv_cancel₀ h0
  rw [eq_div_iff (mul_ne_zero h h0)]
  simp only [ggo, ellx, div_eq_mul_inv]
  linear_combination (bt0 m * bo m * s * (-S + cpo m * s) * (-alo m S + beo m S * s0)) * k1
    + (-(bt0 m * bo m * s0 * (-S + cpo m * s0) * (-alo m S + beo m S * s))) * k0

/-- `(To/2) κ_o = Lam − 1/(4 To)`. -/
theorem kapo_rel (m : ℝ) (hm : 7 ≤ m) : To m / 2 * kapo m = Lam m - 1 / (4 * To m) := by
  have h1 : 2 * m - 3 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  simp only [To, Lam, kapo]; field_simp; ring

theorem ggo_mono (t : ℕ) (S s : ℝ) (hS0 : 1 / 2 ≤ S) (hS1 : S ≤ 1)
    (hs0 : S ^ 2 / ((t : ℝ) + 7) ≤ s) (hs1 : s ≤ S / 2) :
    kapo ((t : ℝ) + 7) * (s - S ^ 2 / ((t : ℝ) + 7))
      ≤ ggo ((t : ℝ) + 7) S s - ggo ((t : ℝ) + 7) S (S ^ 2 / ((t : ℝ) + 7)) := by
  have hq0 := cert_enum0 t S hS0 hS1
  have hqh := cert_enumh t S hS0 hS1
  have hN0 := cert_ell0 t S hS0 hS1
  have hNh := cert_ellh t S hS0 hS1
  simp only at hq0 hqh hN0 hNh
  set m : ℝ := (t : ℝ) + 7 with hm
  have hm7 : 7 ≤ m := by rw [hm]; have : (0 : ℝ) ≤ t := t.cast_nonneg; linarith
  set s0 := S ^ 2 / m with hs0def
  have hS : 0 < S := by linarith
  have hm2 : 0 < m - 2 := by linarith
  have hm1 : 0 < m - 1 := by linarith
  have hm21 : 0 < 2 * m - 1 := by linarith
  have hd0 : 0 < (m - 2) * (m - 1) * (2 * m - 1) ^ 4 := mul_pos (mul_pos hm2 hm1) (pow_pos hm21 4)
  have hD : 0 < (m - 2) ^ 3 * (m - 1) ^ 3 * (2 * m - 1) ^ 12 :=
    mul_pos (mul_pos (pow_pos hm2 3) (pow_pos hm1 3)) (pow_pos hm21 12)
  have hE0 : 0 < alo m S - beo m S * s0 := by
    rw [hs0def, enum0_eq m S hm7]; exact div_pos (mul_pos (by linarith) hq0) hd0
  have hEh : 0 < alo m S - beo m S * (S / 2) := by
    rw [enumh_eq m S hm7]; exact div_pos (mul_pos (by linarith) hqh) hd0
  have hgap : 0 < S / 2 - s0 := by
    rw [hs0def]; rw [sub_pos, div_lt_div_iff₀ (by linarith) (by linarith)]; nlinarith
  have hE : 0 < alo m S - beo m S * s := by
    have e : (S / 2 - s0) * (alo m S - beo m S * s)
        = (S / 2 - s) * (alo m S - beo m S * s0) + (s - s0) * (alo m S - beo m S * (S / 2)) := by ring
    set E0 := alo m S - beo m S * s0 with hE0d
    set Eh := alo m S - beo m S * (S / 2) with hEhd
    have hpos : 0 < (S / 2 - s) * E0 + (s - s0) * Eh := by
      rcases lt_or_eq_of_le hs1 with h | h
      · exact add_pos_of_pos_of_nonneg (mul_pos (by linarith) hE0) (mul_nonneg (by linarith) hEh.le)
      · rw [h, sub_self, zero_mul, zero_add]; exact mul_pos (by linarith) hEh
    rw [← e] at hpos
    exact pos_of_mul_pos_right hpos hgap.le
  have hl0 : 0 ≤ ellx m S s0 s0 := by
    rw [hs0def, ell0_eq m S hm7]; exact div_nonneg (mul_nonneg (by positivity) hN0) hD.le
  have hlh : 0 ≤ ellx m S (S / 2) s0 := by
    rw [hs0def, ellh_eq m S hm7]
    apply div_nonneg _ hD.le
    have : 0 ≤ 16 * S ^ 2 * m := by positivity
    have hNh' : 0 ≤ -NUMhP m S := by simp only [NUMhP]; linarith [hNh]
    have := mul_nonneg this hNh'
    linarith
  have hl : 0 ≤ ellx m S s s0 := by
    have e : (S / 2 - s0) * ellx m S s s0 = (S / 2 - s) * ellx m S s0 s0 + (s - s0) * ellx m S (S / 2) s0 := by
      simp only [ellx]; ring
    have : 0 ≤ (S / 2 - s0) * ellx m S s s0 := by
      rw [e]; exact add_nonneg (mul_nonneg (by linarith) hl0) (mul_nonneg (by linarith) hlh)
    exact nonneg_of_mul_nonneg_right this hgap
  have hdiff := ggo_diff m S s s0 hE.ne' hE0.ne'
  have : 0 ≤ (s - s0) * ellx m S s s0 / ((alo m S - beo m S * s) * (alo m S - beo m S * s0)) :=
    div_nonneg (mul_nonneg (by linarith) hl) (mul_pos hE hE0).le
  linarith

theorem enum_pos (t : ℕ) (S s : ℝ) (hS0 : 1 / 2 ≤ S) (hS1 : S ≤ 1)
    (hs0 : S ^ 2 / ((t : ℝ) + 7) ≤ s) (hs1 : s ≤ S / 2) :
    0 < alo ((t : ℝ) + 7) S - beo ((t : ℝ) + 7) S * s := by
