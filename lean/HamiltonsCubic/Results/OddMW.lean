import HamiltonsCubic.Results.MWPrime

set_option linter.style.longLine false

/-!
# The odd MW', the walk inequality of J1 on the torus slice of `so(2m + 1)`, for `m ≥ 7`

[The R48 working note](../../../reviews/2026-09-27-R48-torus-families.md), batches 6 to 10, Gate 2 by r1696 and
r1697. The odd walk has the old vertices `1, …, m` (here `Fin (n + 1)`, `m = n + 1`) and one distinguished vertex `0`,
carried as the old-old weights `W` and the new-edge weights `u i = w_{i0}`. With `π_i = Σ_j W i j + u i`,
`π_0 = Σ_i u i` and every constant divided by `√2` (`To = t_o/√2`, `Tn = t_n/√2`, `Lam = λ/√2`, `C0 = c₀/√2`), the odd
MW' is `oddMWprime`.

The proof, one declaration per step of batch 10:
- `scaled_left_concave`: L276's `left_concave` on the scaled simplex `Σ q = σ ≤ 1`, from the same two-value
  hypothesis at `σ = 1`, because the two-value slack is non-decreasing in the scale (`concave_inner`).
- `scaled_R0`, `scaled_Rhalf`, `scaled_row_chord`: L276's row chord on the scaled simplex, from R0's and R½'s
  per-entry majorants (`f0_per`, `fh_per`), their concavity (`f0_concave`, `fh_concave`) and two-value
  inequalities (`f0_two`, `fh_two`), which `R0` and `Rhalf` prove inside their own bodies.
- `old_row` (step 3), `new_edge` (step 1), `row0` (step 2, `R0` on row `0` at a lowered slope), `column_cs`
  (step 4, with `cs2`), `psit_tangent` and `psit_line` (step 5's concave majorant), `phi_tangent` (step 6).
- `ggo_mono` (step 8: `s_o²/D` minus `κ_o s_o` is non-decreasing on `[S²/m, S/2]`), `closing_cubic` and
  `closing_line` (step 9, both branches of the majorant). Their polynomial facts are Bernstein certificates in `S`
  whose coefficients are polynomials in `t = m − 7` with non-negative coefficients (`cert_*`, generated by
  [cert_oddmw.py](../../../scripts/misc/cert_oddmw.py)), and the side conditions are `side_*`.
- `oddMWprime`: the assembly.
-/

namespace HamiltonsCubic.OddMW

open Finset HamiltonsCubic.MWPrime

noncomputable def To (m : ℝ) : ℝ := (2 * m - 1) ^ 2 / (4 * m * (2 * m - 3))
noncomputable def Tn (m : ℝ) : ℝ := (2 * m - 1) / (4 * (m - 1))
noncomputable def Lam (m : ℝ) : ℝ := 3 * m / (2 * (2 * m - 1))
noncomputable def C0 (m : ℝ) : ℝ := (2 * m - 1) * (4 * m - 1) / (8 * m ^ 2)

/-- A concave function lies above its chord: `(v − u) f w ≥ (v − w) f u + (w − u) f v` for `u ≤ w ≤ v` in the domain. -/
theorem concave_inner {s : Set ℝ} {f : ℝ → ℝ} (hf : ConcaveOn ℝ s f) {u v w : ℝ} (hu : u ∈ s) (hv : v ∈ s)
    (huw : u ≤ w) (hwv : w ≤ v) :
    (v - w) * f u + (w - u) * f v ≤ (v - u) * f w := by
  rcases eq_or_lt_of_le (huw.trans hwv) with h | h
  · have e1 : w = u := le_antisymm (h ▸ hwv) huw
    subst e1; rw [← h]; ring_nf; rfl
  have hD : 0 < v - u := by linarith
  have ha : 0 ≤ (v - w) / (v - u) := div_nonneg (by linarith) hD.le
  have hb : 0 ≤ (w - u) / (v - u) := div_nonneg (by linarith) hD.le
  have hab : (v - w) / (v - u) + (w - u) / (v - u) = 1 := by field_simp; ring
  have := hf.2 hu hv ha hb hab
  simp only [smul_eq_mul] at this
  have ew : (v - w) / (v - u) * u + (w - u) / (v - u) * v = w := by field_simp; ring
  rw [ew] at this
  have := mul_le_mul_of_nonneg_left this hD.le
  have e2 : (v - u) * ((v - w) / (v - u) * f u + (w - u) / (v - u) * f v) = (v - w) * f u + (w - u) * f v := by
    field_simp
  linarith

/-- **`left_concave` on a scaled simplex.** A function concave on `[0, 1/n]` whose two-value slack at `σ = 1` is
non-positive has `Σ_j f(q_j) ≤ n f(σ/n)` whenever `Σ_j q_j = σ ∈ [0, 1]`. -/
theorem scaled_left_concave (n : ℕ) (hn : 2 ≤ n) (f : ℝ → ℝ) (hf : ConcaveOn ℝ (Set.Icc 0 (1 / (n : ℝ))) f)
    (h2 : ∀ x ∈ Set.Icc (1 / (n : ℝ)) 1, f x + ((n : ℝ) - 1) * f ((1 - x) / ((n : ℝ) - 1)) ≤ n * f (1 / n))
    (σ : ℝ) (hσ0 : 0 ≤ σ) (hσ1 : σ ≤ 1) (q : Fin n → ℝ) (hq : ∀ j, 0 ≤ q j) (hs : ∑ j, q j = σ) :
    ∑ j, f (q j) ≤ n * f (σ / n) := by
  have hN : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hN0 : (0 : ℝ) < n := by linarith
  have hN1 : (0 : ℝ) < (n : ℝ) - 1 := by linarith
  rcases eq_or_lt_of_le hσ0 with h0 | hσp
  · have hz : ∀ j, q j = 0 := by
      intro j
      have := Finset.single_le_sum (fun k _ => hq k) (Finset.mem_univ j)
      rw [hs, ← h0] at this; exact le_antisymm this (hq j)
    simp [hz, ← h0]
  -- the two-value inequality at scale σ, from scale 1 by monotonicity in the scale
  have hmono : ∀ X, σ / n ≤ X → X ≤ σ →
      f X + ((n : ℝ) - 1) * f ((σ - X) / ((n : ℝ) - 1)) ≤ n * f (σ / n) := by
    intro X hX1 hX2
    have hnX : σ ≤ n * X := by rw [div_le_iff₀ hN0] at hX1; linarith
    set τ := min 1 ((n : ℝ) * X) with hτ
    have hτσ : σ ≤ τ := le_min hσ1 hnX
    have hτ1 : τ ≤ 1 := min_le_left _ _
    have hτX : τ ≤ n * X := min_le_right _ _
    set y := (σ - X) / ((n : ℝ) - 1) with hy
    set y' := (τ - X) / ((n : ℝ) - 1) with hy'
    set yb := σ / n with hyb
    set yb' := τ / n with hyb'
    have hy0 : 0 ≤ y := div_nonneg (by linarith) hN1.le
    have hyy' : y ≤ y' := div_le_div_of_nonneg_right (by linarith) hN1.le
    have hyyb : y ≤ yb := by
      rw [hy, hyb, div_le_div_iff₀ hN1 hN0]; nlinarith
    have hy'yb' : y' ≤ yb' := by
      rw [hy', hyb', div_le_div_iff₀ hN1 hN0]; nlinarith
    have hybyb' : yb ≤ yb' := div_le_div_of_nonneg_right hτσ hN0.le
    have hyb'c : yb' ≤ 1 / n := div_le_div_of_nonneg_right hτ1 hN0.le
    have hmem : ∀ z, 0 ≤ z → z ≤ 1 / (n : ℝ) → z ∈ Set.Icc 0 (1 / (n : ℝ)) := fun z h1 h2 => ⟨h1, h2⟩
    have hyM := hmem y hy0 (by linarith)
    have hyb'M := hmem yb' (by linarith) hyb'c
    have i1 := concave_inner hf hyM hyb'M hyy' hy'yb'
    have i2 := concave_inner hf hyM hyb'M hyyb hybyb'
    have eA : ((n : ℝ) - 1) * (y' - y) = n * (yb' - yb) := by
      rw [hy, hy', hyb, hyb']; field_simp; ring
    have key : ((n : ℝ) - 1) * f y + n * f yb' ≤ ((n : ℝ) - 1) * f y' + n * f yb := by
      rcases eq_or_lt_of_le (hyyb.trans hybyb') with hD | hD
      · have e1 : y' = y := le_antisymm (hD ▸ hy'yb') hyy'
        have e2 : yb = y := le_antisymm (hD ▸ hybyb') hyyb
        rw [e1, e2, ← hD]
      have hD' : 0 < yb' - y := by linarith
      have hsum : (yb' - y) * (((n : ℝ) - 1) * f y + n * f yb')
          ≤ (yb' - y) * (((n : ℝ) - 1) * f y' + n * f yb) := by
        have c1 := mul_le_mul_of_nonneg_left i1 hN1.le
        have c2 := mul_le_mul_of_nonneg_left i2 hN0.le
        have e3 : ((n : ℝ) - 1) * ((yb' - y') * f y + (y' - y) * f yb') + n * ((yb' - yb) * f y + (yb - y) * f yb')
            = (yb' - y) * (((n : ℝ) - 1) * f y + n * f yb') := by
          have : ((n : ℝ) - 1) * (yb' - y') + n * (yb' - yb) = ((n : ℝ) - 1) * (yb' - y) := by linarith
          have : ((n : ℝ) - 1) * (y' - y) + n * (yb - y) = n * (yb' - y) := by linarith
          linear_combination (f y) * ‹((n : ℝ) - 1) * (yb' - y') + n * (yb' - yb) = ((n : ℝ) - 1) * (yb' - y)›
            + (f yb') * ‹((n : ℝ) - 1) * (y' - y) + n * (yb - y) = n * (yb' - y)›
        nlinarith
      exact le_of_mul_le_mul_left hsum hD'
    have hend : f X + ((n : ℝ) - 1) * f y' ≤ n * f yb' := by
      rcases le_total ((n : ℝ) * X) 1 with h | h
      · have hτe : τ = n * X := min_eq_right h
        have e1 : y' = X := by rw [hy', hτe]; field_simp
        have e2 : yb' = X := by rw [hyb', hτe]; field_simp
        rw [e1, e2]; exact le_of_eq (by ring)
      · have hτe : τ = 1 := min_eq_left h
        have hX1' : 1 / (n : ℝ) ≤ X := by rw [div_le_iff₀ hN0]; linarith
        have := h2 X ⟨hX1', le_trans hX2 hσ1⟩
        rw [hy', hyb', hτe]; exact this
    linarith
  -- apply left_concave to p ↦ f (σ p)
  set g : ℝ → ℝ := fun p => f (σ * p) with hg
  have hgc : ConcaveOn ℝ (Set.Icc 0 (1 / (n : ℝ))) g := by
    refine ⟨convex_Icc _ _, fun u hu v hv a b ha hb hab => ?_⟩
    have hsc : ∀ z ∈ Set.Icc 0 (1 / (n : ℝ)), σ * z ∈ Set.Icc 0 (1 / (n : ℝ)) := fun z hz =>
      ⟨mul_nonneg hσ0 hz.1, by nlinarith [hz.1, hz.2, one_div_pos.mpr hN0]⟩
    have := hf.2 (hsc u hu) (hsc v hv) ha hb hab
    simp only [smul_eq_mul, hg] at this ⊢
    have e : σ * (a * u + b * v) = a * (σ * u) + b * (σ * v) := by ring
    rw [e]; exact this
  have hg2 : ∀ x ∈ Set.Icc (1 / (n : ℝ)) 1, g x + ((n : ℝ) - 1) * g ((1 - x) / ((n : ℝ) - 1)) ≤ n * g (1 / n) := by
    intro x hx
    simp only [hg]
    have hxn : 1 ≤ x * n := by have := hx.1; rwa [div_le_iff₀ hN0] at this
    have h1 : σ / n ≤ σ * x := by
      rw [div_le_iff₀ hN0]; nlinarith [mul_le_mul_of_nonneg_left hxn hσ0]
    have h2' : σ * x ≤ σ := by nlinarith [hx.2]
    have := hmono (σ * x) h1 h2'
    have e1 : σ * ((1 - x) / ((n : ℝ) - 1)) = (σ - σ * x) / ((n : ℝ) - 1) := by field_simp
    have e2 : σ * (1 / (n : ℝ)) = σ / n := by ring
    rw [e1, e2]; exact this
  have hq' : ∀ j, 0 ≤ q j / σ := fun j => div_nonneg (hq j) hσp.le
  have hs' : ∑ j, q j / σ = 1 := by rw [← Finset.sum_div, hs, div_self hσp.ne']
  have := left_concave n hn g hgc hg2 (fun j => q j / σ) hq' hs'
  simp only [hg] at this
  have e : ∀ j, σ * (q j / σ) = q j := fun j => by field_simp
  simp only [e] at this
  have e2 : σ * (1 / (n : ℝ)) = σ / n := by ring
  rw [e2] at this
  exact this

/-! ### L276's endpoint facts as standalone lemmas

`R0` and `Rhalf` prove these inside their own bodies; the scaled chord needs them on their own. -/

theorem f0_at (N : ℝ) (hN : 2 ≤ N) (x : ℝ) (hx : x ≤ 1 / N) : f0 N x = x * (1 - x) * (2 / N - 2 * x) := by
  have hN0 : (0 : ℝ) < N := by linarith
  have hc2 : 1 / N ≤ 1 / 2 := div_le_div_of_nonneg_left (by norm_num) (by norm_num) hN
  rw [f0, max_eq_right (by linarith)]; field_simp; ring

/-- `R0`'s per-entry bound. -/
theorem f0_per (N x g : ℝ) (hN : 0 < N) (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    x * (1 - x) * (1 + g * (1 - 2 * x)) - 2 * (N - 1) / N * (x * (1 - x)) ≤ f0 N x := by
  have hqq : 0 ≤ x * (1 - x) := mul_nonneg hx0 (by linarith)
  have hmax : g * (1 - 2 * x) ≤ max 0 (1 - 2 * x) := by
    rcases le_total 0 (1 - 2 * x) with h | h
    · rw [max_eq_right h]; nlinarith
    · rw [max_eq_left h]; nlinarith
  have e : x * (1 - x) * (1 + g * (1 - 2 * x)) - 2 * (N - 1) / N * (x * (1 - x))
      = x * (1 - x) * ((2 - N) / N + g * (1 - 2 * x)) := by field_simp; ring
  rw [e, f0]; exact mul_le_mul_of_nonneg_left (by linarith) hqq

theorem f0_concave (N : ℝ) (hN : 6 ≤ N) : ConcaveOn ℝ (Set.Icc 0 (1 / N)) (f0 N) := by
  have hN0 : (0 : ℝ) < N := by linarith
  have hc2 : 1 / N ≤ 1 / 6 := div_le_div_of_nonneg_left (by norm_num) (by norm_num) hN
  refine ⟨convex_Icc 0 (1 / N), fun u hu v hv a b ha hb hab => ?_⟩
  simp only [smul_eq_mul]
  have hw : a * u + b * v ≤ 1 / N := by nlinarith [hu.2, hv.2]
  rw [f0_at N (by linarith) u hu.2, f0_at N (by linarith) v hv.2, f0_at N (by linarith) _ hw]
  have hb' : b = 1 - a := by linarith
  subst hb'
  have e : (a * u + (1 - a) * v) * (1 - (a * u + (1 - a) * v)) * (2 / N - 2 * (a * u + (1 - a) * v))
      - (a * (u * (1 - u) * (2 / N - 2 * u)) + (1 - a) * (v * (1 - v) * (2 / N - 2 * v)))
      = a * (1 - a) * (u - v) ^ 2 * (2 + 2 / N - 2 * (a * u - a * v + u + 2 * v)) := by ring
  have hbr : 0 ≤ 2 + 2 / N - 2 * (a * u - a * v + u + 2 * v) := by
    have : 0 ≤ 2 / N := by positivity
    have h1 : a * u ≤ u := by nlinarith [hu.1]
    have h2 : 0 ≤ a * v := mul_nonneg ha hv.1
    linarith [hu.2, hv.2]
  have : 0 ≤ a * (1 - a) * (u - v) ^ 2 * (2 + 2 / N - 2 * (a * u - a * v + u + 2 * v)) :=
    mul_nonneg (mul_nonneg (mul_nonneg ha hb) (sq_nonneg _)) hbr
  linarith

theorem f0_two (N : ℝ) (hN : 6 ≤ N) :
    ∀ x ∈ Set.Icc (1 / N) 1, f0 N x + (N - 1) * f0 N ((1 - x) / (N - 1)) ≤ N * f0 N (1 / N) := by
  have hN0 : (0 : ℝ) < N := by linarith
  have hN1 : (0 : ℝ) < N - 1 := by linarith
  set c : ℝ := 1 / N with hc
  have hNc : N * c = 1 := by rw [hc]; field_simp
  have hf0c : ∀ x, x ≤ c → f0 N x = x * (1 - x) * (2 * c - 2 * x) := fun x hx => by
    rw [f0_at N (by linarith) x hx, hc]; ring
  have hf0cc : f0 N c = 0 := by rw [hf0c c le_rfl]; ring
  intro x hx
  rw [hf0cc, mul_zero]
  set y := (1 - x) / (N - 1) with hy
  have hy0 : 0 ≤ y := div_nonneg (by linarith [hx.2]) hN1.le
  have hyc : y ≤ c := by
    rw [hy, div_le_iff₀ hN1]
    have : (N - 1) * c = 1 - c := by rw [sub_mul, hNc, one_mul]
    linarith [hx.1]
  rw [hf0c y hyc]
  rcases le_or_gt x (1 / 2) with hx2 | hx2
  · have hxm : max 0 (1 - 2 * x) = 1 - 2 * x := max_eq_right (by linarith)
    rw [f0, hxm]
    have e : x * (1 - x) * ((2 - N) / N + (1 - 2 * x)) + (N - 1) * (y * (1 - y) * (2 * c - 2 * y))
        = -2 * (x - c) ^ 2 * ((1 - c - x) + (1 - c - y) / (N - 1)) := by
      rw [hy, hc]; exact id_r0_small N x hN0.ne' hN1.ne'
    rw [e]
    have : 0 ≤ (1 - c - x) + (1 - c - y) / (N - 1) := by
      have hc6 : c ≤ 1 / 6 := by rw [hc]; exact div_le_div_of_nonneg_left (by norm_num) (by norm_num) hN
      exact add_nonneg (by linarith) (div_nonneg (by linarith) hN1.le)
    nlinarith [sq_nonneg (x - c)]
  · have hxm : max 0 (1 - 2 * x) = 0 := max_eq_left (by linarith)
    rw [f0, hxm]
    have e : x * (1 - x) * ((2 - N) / N + 0) + (N - 1) * (y * (1 - y) * (2 * c - 2 * y))
        = (1 - x) * (2 * N * x ^ 2 - N * (N - 3) ^ 2 * x - 2 * (N - 2)) / (N * (N - 1) ^ 2) := by
      rw [hy, hc]; exact id_r0_big N x hN0.ne' hN1.ne'
    rw [e]
    apply div_nonpos_of_nonpos_of_nonneg _ (by positivity)
    have hG : 2 * N * x ^ 2 - N * (N - 3) ^ 2 * x - 2 * (N - 2) ≤ 0 := by
      have e2 : 2 * N * x ^ 2 - N * (N - 3) ^ 2 * x - 2 * (N - 2)
          = (2 - 2 * x) * ((-N * (N - 3) ^ 2 - 3 * N + 8) / 2) + (2 * x - 1) * (4 - N * (N - 3) ^ 2)
            + 2 * N * ((x - 1 / 2) * (x - 1)) := by ring
      rw [e2]
      have g1 : (-N * (N - 3) ^ 2 - 3 * N + 8) / 2 ≤ 0 := by nlinarith
      have g2 : 4 - N * (N - 3) ^ 2 ≤ 0 := by nlinarith
      have g3 : (x - 1 / 2) * (x - 1) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith [hx.2])
      have k1 := mul_nonpos_of_nonneg_of_nonpos (by linarith [hx.2] : (0:ℝ) ≤ 2 - 2 * x) g1
      have k2 := mul_nonpos_of_nonneg_of_nonpos (by linarith [hx2] : (0:ℝ) ≤ 2 * x - 1) g2
      have k3 := mul_nonpos_of_nonneg_of_nonpos (by linarith : (0:ℝ) ≤ 2 * N) g3
      linarith
    exact mul_nonpos_of_nonneg_of_nonpos (by linarith [hx.2]) hG

theorem Kt_pos (N : ℝ) (hN : 6 ≤ N) : 0 < Kt N := by
  have : (0 : ℝ) < N := by linarith
  simp only [Kt]; apply div_pos _ (by positivity); nlinarith

theorem Kt_lt_one (N : ℝ) (hN : 6 ≤ N) : Kt N < 1 := by
  simp only [Kt]; rw [div_lt_one (by positivity)]; nlinarith

theorem fh_at (N x : ℝ) (hx : x ≤ 7 / 32) : fh N x = psiL N x := by simp [fh, hx]

/-- `Rhalf`'s per-entry bound. -/
theorem fh_per (N x g : ℝ) (hN : 6 ≤ N) (hx0 : 0 ≤ x) (hx1 : x ≤ 1) (hg0 : 0 ≤ g) (hg1 : g ≤ 1) :
    x * (1 - x) * (1 + g * (1 - 2 * x)) + Kt N * x ^ 2 * (1 - g ^ 2) - Kt N * x - sh N * (x * (1 - x)) ≤ fh N x := by
  have hKt0 := Kt_pos N hN
  have hKt1 := Kt_lt_one N hN
  have e : x * (1 - x) * (1 + g * (1 - 2 * x)) + Kt N * x ^ 2 * (1 - g ^ 2) - Kt N * x - sh N * (x * (1 - x))
      = x * (1 - x) * (g * (1 - 2 * x) + Ah N) - Kt N * g ^ 2 * x ^ 2 := by simp only [Ah]; ring
  rw [e]
  unfold fh
  split_ifs with h1 h2
  · have hlight : Kt N * x * (1 + g) ≤ (1 - x) * (1 - 2 * x) := by
      have a1 : Kt N * x * (1 + g) ≤ 2 * x := by nlinarith [mul_nonneg hx0 hg0, mul_nonneg hKt0.le hx0]
      have a2 : 2 * x ≤ (1 - x) * (1 - 2 * x) := by
        nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ 7 / 32 - x) (by linarith : (0:ℝ) ≤ 73 / 16 - 2 * x)]
      linarith
    have e2 : psiL N x - (x * (1 - x) * (g * (1 - 2 * x) + Ah N) - Kt N * g ^ 2 * x ^ 2)
        = (1 - g) * x * ((1 - x) * (1 - 2 * x) - Kt N * x * (1 + g)) := by simp only [psiL]; ring
    have : 0 ≤ (1 - g) * x * ((1 - x) * (1 - 2 * x) - Kt N * x * (1 + g)) :=
      mul_nonneg (mul_nonneg (by linarith) hx0) (by linarith)
    linarith
  · have hxp : 0 < x := by linarith
    have e2 : psih N x - (x * (1 - x) * (g * (1 - 2 * x) + Ah N) - Kt N * g ^ 2 * x ^ 2)
        = (x * (1 - x) * (1 - 2 * x) - 2 * Kt N * x ^ 2 * g) ^ 2 / (4 * Kt N * x ^ 2) := by
      simp only [psih]; exact id_psih_gap (Kt N) (Ah N) x g hKt0.ne' hxp.ne'
    have : 0 ≤ (x * (1 - x) * (1 - 2 * x) - 2 * Kt N * x ^ 2 * g) ^ 2 / (4 * Kt N * x ^ 2) := by positivity
    linarith
  · have : 0 ≤ -(g * (x * (1 - x) * (1 - 2 * x))) + Kt N * g ^ 2 * x ^ 2 := by
      have : x * (1 - x) * (1 - 2 * x) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hx0 (by linarith)) (by linarith)
      nlinarith [mul_nonneg hg0 (sq_nonneg x), mul_nonneg hKt0.le (mul_nonneg (sq_nonneg g) (sq_nonneg x))]
    nlinarith

theorem fh_concave (N : ℝ) (hN : 6 ≤ N) : ConcaveOn ℝ (Set.Icc 0 (1 / N)) (fh N) := by
  have hN0 : (0 : ℝ) < N := by linarith
  have hKt0 := Kt_pos N hN
  have hc6 : 1 / N ≤ 1 / 6 := div_le_div_of_nonneg_left (by norm_num) (by norm_num) hN
  refine ⟨convex_Icc 0 (1 / N), fun u hu v hv a b ha hb hab => ?_⟩
  simp only [smul_eq_mul]
  have hw : a * u + b * v ≤ 1 / N := by nlinarith [hu.2, hv.2]
  rw [fh_at N u (by linarith [hu.2]), fh_at N v (by linarith [hv.2]), fh_at N _ (by linarith)]
  have hb' : b = 1 - a := by linarith
  subst hb'
  have e : psiL N (a * u + (1 - a) * v) - (a * psiL N u + (1 - a) * psiL N v)
      = a * (1 - a) * (u - v) ^ 2 * ((3 + Ah N + Kt N) - 2 * (a * u - a * v + u + 2 * v)) := by
    simp only [psiL]; ring
  have hA : 3 + Ah N + Kt N = 4 - sh N := by simp only [Ah]; ring
  have hsh1 : sh N ≤ 1 := by simp only [sh]; rw [div_le_one (by positivity)]; nlinarith
  have hbr : 0 ≤ (3 + Ah N + Kt N) - 2 * (a * u - a * v + u + 2 * v) := by
    rw [hA]; nlinarith [hu.1, hv.1, hu.2, hv.2]
  have : 0 ≤ a * (1 - a) * (u - v) ^ 2 * ((3 + Ah N + Kt N) - 2 * (a * u - a * v + u + 2 * v)) :=
    mul_nonneg (mul_nonneg (mul_nonneg ha hb) (sq_nonneg _)) hbr
  linarith

theorem fh_two (t : ℕ) :
    ∀ x ∈ Set.Icc (1 / ((t : ℝ) + 6)) 1, fh ((t : ℝ) + 6) x + ((t : ℝ) + 6 - 1) * fh ((t : ℝ) + 6) ((1 - x) / ((t : ℝ) + 6 - 1))
      ≤ ((t : ℝ) + 6) * fh ((t : ℝ) + 6) (1 / ((t : ℝ) + 6)) := by
  set N : ℝ := (t : ℝ) + 6 with hNt
  have hN : (6 : ℝ) ≤ N := by rw [hNt]; have : (0 : ℝ) ≤ t := t.cast_nonneg; linarith
  have hN0 : (0 : ℝ) < N := by linarith
  have hN1 : (0 : ℝ) < N - 1 := by linarith
  set c : ℝ := 1 / N with hc
  have hc6 : c ≤ 1 / 6 := by rw [hc]; exact div_le_div_of_nonneg_left (by norm_num) (by norm_num) hN
  have hNc : N * c = 1 := by rw [hc]; field_simp
  have hpsiLc : psiL N c = 0 := by rw [hc]; exact id_psiLc N hN0.ne'
  have hfhc : fh N c = 0 := by rw [fh_at N c (by linarith), hpsiLc]
  intro x hx
  rw [hfhc, mul_zero]
  set y := (1 - x) / (N - 1) with hy
  have hy0 : 0 ≤ y := div_nonneg (by linarith [hx.2]) hN1.le
  have hyc : y ≤ c := by
    rw [hy, div_le_iff₀ hN1]
    have : (N - 1) * c = 1 - c := by rw [sub_mul, hNc, one_mul]
    linarith [hx.1]
  rw [fh_at N y (by linarith)]
  unfold fh
  split_ifs with h1 h2
  · set r : ℝ := (3 * N + 1) * (N - 1) / (2 * N ^ 2) with hr
    have hr1 : 1 < r := by rw [hr, lt_div_iff₀ (by positivity)]; nlinarith
    have e : psiL N x + (N - 1) * psiL N y = 2 * (x - c) ^ 2 * ((x - r) + (y - r) / (N - 1)) := by
      rw [hy, hc, hr]; exact id_i N x hN0.ne' hN1.ne'
    rw [e]
    have : (x - r) + (y - r) / (N - 1) ≤ 0 := by
      have : (y - r) / (N - 1) ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hN1.le
      linarith [hx.2]
    nlinarith [sq_nonneg (x - c)]
  · have e : psih N x + (N - 1) * psiL N y
        = (x - 1) * (4*N^6*x^3-8*N^6*x^2+9*N^6*x-N^6-28*N^5*x-8*N^4*x^2+16*N^4*x+12*N^4-8*N^3*x^2+52*N^3*x-8*N^3-8*N^2*x-24*N^2-8*N*x+4*x+4)
          / (4 * N ^ 3 * (N - 1) ^ 2 * (N + 1)) := by
      rw [hy]; exact id_ii N x hN0.ne' hN1.ne' (by linarith)
    rw [e]
    have hL := L2_nonneg t x (by linarith) h2
    simp only at hL
    rw [← hNt] at hL
    apply div_nonpos_of_nonpos_of_nonneg _ (by positivity)
    exact mul_nonpos_of_nonpos_of_nonneg (by linarith [hx.2]) hL
  · have e : x * (1 - x) * Ah N + (N - 1) * psiL N y
        = (1 - x) * (2*N^3*x^2+(-N^5+8*N^4-12*N^3-N^2+3*N-1)*x-3*N^3+5*N^2+N-1) / (N ^ 3 * (N - 1) ^ 2) := by
      rw [hy]; exact id_iii N x hN0.ne' hN1.ne'
    rw [e]
    have hL := L1_nonpos t x (by linarith) hx.2
    simp only at hL
    rw [← hNt] at hL
    apply div_nonpos_of_nonpos_of_nonneg _ (by positivity)
    exact mul_nonpos_of_nonneg_of_nonpos (by linarith [hx.2]) hL

/-! ### The scaled chord -/

/-- **R0 on a scaled simplex**: `Σ_j q_j(1 − q_j)(1 + γ_j(1 − 2q_j)) ≤ G_u(σ) + b₀(σ²/n − Σ q_j²)` for `Σ q = σ ∈ [0, 1]`. -/
theorem scaled_R0 (n : ℕ) (hn : 6 ≤ n) (σ : ℝ) (hσ0 : 0 ≤ σ) (hσ1 : σ ≤ 1) (q γ : Fin n → ℝ) (hq : ∀ j, 0 ≤ q j)
    (hs : ∑ j, q j = σ) (hγ : ∀ j, 0 ≤ γ j ∧ γ j ≤ 1) :
    ∑ j, q j * (1 - q j) * (1 + γ j * (1 - 2 * q j))
      ≤ 2 * σ * (1 - σ / n) ^ 2 + MWPrime.slope n 0 * (σ ^ 2 / n - ∑ j, q j ^ 2) := by
  have hN : (6 : ℝ) ≤ n := by exact_mod_cast hn
  have hN0 : (0 : ℝ) < n := by linarith
  have hq1 : ∀ j, q j ≤ 1 := fun j => by
    have := Finset.single_le_sum (fun k _ => hq k) (Finset.mem_univ j); linarith
  have hsum := scaled_left_concave n (by omega) (f0 n) (f0_concave n hN) (f0_two n hN) σ hσ0 hσ1 q hq hs
  have hle := Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) =>
    f0_per n (q j) (γ j) hN0 (hq j) (hq1 j) (hγ j).1 (hγ j).2
  rw [Finset.sum_sub_distrib] at hle
  have hlin : ∑ j, 2 * ((n : ℝ) - 1) / n * (q j * (1 - q j)) = 2 * ((n : ℝ) - 1) / n * (σ - ∑ j, q j ^ 2) := by
    rw [← Finset.mul_sum]; congr 1
    rw [← hs, ← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl fun j _ => by ring
  have hid : (n : ℝ) * f0 n (σ / n) = 2 * σ * (1 - σ / n) ^ 2 + 2 * ((n : ℝ) - 1) / n * (σ ^ 2 / n) - 2 * ((n : ℝ) - 1) / n * σ := by
    rw [f0_at n (by linarith) (σ / n) (div_le_div_of_nonneg_right hσ1 hN0.le)]
    field_simp; ring
  have hsl : MWPrime.slope n 0 = 2 * ((n : ℝ) - 1) / n := by simp [MWPrime.slope]
  rw [hsl]
  linarith

/-- **R½ on a scaled simplex.** -/
theorem scaled_Rhalf (n : ℕ) (hn : 6 ≤ n) (σ : ℝ) (hσ0 : 0 ≤ σ) (hσ1 : σ ≤ 1) (q γ : Fin n → ℝ) (hq : ∀ j, 0 ≤ q j)
    (hs : ∑ j, q j = σ) (hγ : ∀ j, 0 ≤ γ j ∧ γ j ≤ 1) :
    ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + kap n * (1 / 2) * q j ^ 2 * (1 - γ j ^ 2))
      ≤ 2 * σ * (1 - σ / n) ^ 2 + MWPrime.slope n (1 / 2) * (σ ^ 2 / n - ∑ j, q j ^ 2) := by
  have hN : (6 : ℝ) ≤ n := by exact_mod_cast hn
  have hN0 : (0 : ℝ) < n := by linarith
  have hq1 : ∀ j, q j ≤ 1 := fun j => by
    have := Finset.single_le_sum (fun k _ => hq k) (Finset.mem_univ j); linarith
  have hKt : kap n * (1 / 2) = Kt n := by simp only [kap, Kt]; ring
  have hsh : MWPrime.slope n (1 / 2) = sh n := by simp only [MWPrime.slope, sh, kap]; field_simp; ring
  rw [hKt, hsh]
  have htwo : ∀ x ∈ Set.Icc (1 / (n : ℝ)) 1,
      fh n x + ((n : ℝ) - 1) * fh n ((1 - x) / ((n : ℝ) - 1)) ≤ n * fh n (1 / n) := by
    obtain ⟨t, rfl⟩ : ∃ t, n = t + 6 := ⟨n - 6, by omega⟩
    have hc : ((t + 6 : ℕ) : ℝ) = (t : ℝ) + 6 := by push_cast; ring
    rw [hc]; exact fh_two t
  have hsum := scaled_left_concave n (by omega) (fh n) (fh_concave n hN) htwo σ hσ0 hσ1 q hq hs
  have hle := Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) => fh_per n (q j) (γ j) hN (hq j) (hq1 j) (hγ j).1 (hγ j).2
  have hlin : ∑ j, (Kt n * q j + sh n * (q j * (1 - q j))) = Kt n * σ + sh n * (σ - ∑ j, q j ^ 2) := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, hs]; congr 2
    rw [← hs, ← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl fun j _ => by ring
  have hid : (n : ℝ) * fh n (σ / n) = 2 * σ * (1 - σ / n) ^ 2 - Kt n * σ - sh n * σ + sh n * (σ ^ 2 / n) := by
    have h7 : σ / n ≤ 7 / 32 := by
      rw [div_le_iff₀ hN0]; nlinarith
    rw [fh_at n _ h7]; simp only [psiL, Ah]; field_simp; ring
  have e3 : ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + Kt n * q j ^ 2 * (1 - γ j ^ 2) - Kt n * q j
      - sh n * (q j * (1 - q j))) = ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + Kt n * q j ^ 2 * (1 - γ j ^ 2))
        - ∑ j, (Kt n * q j + sh n * (q j * (1 - q j))) := by
    rw [← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl fun j _ => by ring
  rw [e3, hlin] at hle
  linarith

/-- **The scaled row chord**: L276's row chord on `Σ_j q_j = σ ∈ [0, 1]`, at any `κ ≤ κ(n)` and `π ∈ [0, ½]`. -/
theorem scaled_row_chord (n : ℕ) (hn : 6 ≤ n) (κ p σ : ℝ) (hκ0 : 0 ≤ κ) (hκ : κ ≤ kap n) (hp0 : 0 ≤ p)
    (hp1 : p ≤ 1 / 2) (hσ0 : 0 ≤ σ) (hσ1 : σ ≤ 1) (q γ : Fin n → ℝ) (hq : ∀ j, 0 ≤ q j) (hs : ∑ j, q j = σ)
    (hγ : ∀ j, 0 ≤ γ j ∧ γ j ≤ 1) :
    ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + κ * p * q j ^ 2 * (1 - γ j ^ 2))
      ≤ 2 * σ * (1 - σ / n) ^ 2 + (2 * ((n : ℝ) - 1) / n - n * κ * p / ((n : ℝ) - 1)) * (σ ^ 2 / n - ∑ j, q j ^ 2) := by
  have hN : (6 : ℝ) ≤ n := by exact_mod_cast hn
  have hN0 : (0 : ℝ) < n := by linarith
  have hN1 : (0 : ℝ) < (n : ℝ) - 1 := by linarith
  have hk : 0 < kap n := by simp only [kap]; apply div_pos _ (by positivity); nlinarith
  set p' := κ * p / kap n with hp'
  have hp'0 : 0 ≤ p' := div_nonneg (mul_nonneg hκ0 hp0) hk.le
  have hp'1 : p' ≤ 1 / 2 := by
    rw [hp', div_le_iff₀ hk]; nlinarith
  have hkp : κ * p = kap n * p' := by rw [hp']; field_simp
  have h0 := scaled_R0 n hn σ hσ0 hσ1 q γ hq hs hγ
  have hh := scaled_Rhalf n hn σ hσ0 hσ1 q γ hq hs hγ
  set S0 := ∑ j, q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) with hS0
  set S1 := ∑ j, kap n * q j ^ 2 * (1 - γ j ^ 2) with hS1
  set ρ := ∑ j, q j ^ 2 with hρ
  have eL : ∀ r : ℝ, ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + kap n * r * q j ^ 2 * (1 - γ j ^ 2)) = S0 + r * S1 := by
    intro r
    rw [Finset.sum_add_distrib, hS1, Finset.mul_sum]
    congr 1; exact Finset.sum_congr rfl fun j _ => by ring
  have eK : ∑ j, (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + κ * p * q j ^ 2 * (1 - γ j ^ 2)) = S0 + p' * S1 := by
    rw [← eL p']; exact Finset.sum_congr rfl fun j _ => by rw [hkp]
  rw [eL] at hh
  rw [eK]
  have hsl : 2 * ((n : ℝ) - 1) / n - n * κ * p / ((n : ℝ) - 1)
      = (1 - 2 * p') * MWPrime.slope n 0 + 2 * p' * MWPrime.slope n (1 / 2) := by
    have : (n : ℝ) * κ * p = n * (kap n * p') := by rw [← hkp]; ring
    rw [this]; simp only [MWPrime.slope]; field_simp; ring
  rw [hsl]
  nlinarith [mul_le_mul_of_nonneg_left h0 (by linarith : (0:ℝ) ≤ 1 - 2 * p'),
    mul_le_mul_of_nonneg_left hh (by linarith : (0:ℝ) ≤ 2 * p')]

