-- the assembly carries about forty named inequalities
/-- **The odd MW'** for `m = n + 1 ≥ 7`, every constant divided by `√2`, with `γ` explicit per ordered old pair. -/
theorem oddMWprime (n : ℕ) (hn : 6 ≤ n) (W : Fin (n + 1) → Fin (n + 1) → ℝ) (u : Fin (n + 1) → ℝ)
    (hW0 : ∀ i j, 0 ≤ W i j) (hsym : ∀ i j, W i j = W j i) (hdiag : ∀ i, W i i = 0) (hu0 : ∀ i, 0 ≤ u i)
    (htot : ∑ i, ∑ j, W i j + 2 * ∑ i, u i = 1)
    (γ : Fin (n + 1) → Fin (n + 1) → ℝ) (hγ : ∀ i j, 0 ≤ γ i j ∧ γ i j ≤ 1) :
    ∑ i, ∑ j, (To (n + 1) / 2 * W i j * (1 - W i j / (∑ k, W i k + u i))
          * (1 + γ i j * (1 - 2 * (W i j / (∑ k, W i k + u i))))
        + (Lam (n + 1) - 1 / (4 * To (n + 1))) * W i j ^ 2 * (1 - γ i j ^ 2))
      + 2 * Tn (n + 1) * ∑ i, u i * (1 - u i / (∑ k, W i k + u i)) * (1 - u i / ∑ k, u k)
      + 1 / (4 * To (n + 1)) * ((∑ i, (∑ k, W i k + u i)) ^ 2 - ∑ i, (∑ k, W i k + u i) ^ 2)
      + (∑ k, u k) * (∑ i, (∑ k, W i k + u i)) / (2 * Tn (n + 1))
      + Lam (n + 1) * ∑ i, (∑ k, W i k + u i) ^ 2
      ≤ C0 (n + 1) := by
  obtain ⟨t, rfl⟩ : ∃ t, n = t + 6 := ⟨n - 6, by omega⟩
  have hmc : ((t + 6 : ℕ) : ℝ) + 1 = (t : ℝ) + 7 := by push_cast; ring
  rw [hmc]
  set m : ℝ := (t : ℝ) + 7 with hm
  have hT0 : (0 : ℝ) ≤ t := t.cast_nonneg
  have hm7 : 7 ≤ m := by rw [hm]; linarith
  set P : Fin (t + 6 + 1) → ℝ := fun i => ∑ k, W i k + u i with hPd
  set P0 : ℝ := ∑ k, u k with hP0d
  set S : ℝ := ∑ i, P i with hSd
  set s : ℝ := ∑ i, P i ^ 2 with hsd
  -- the walk
  have hrow0 : ∀ i, 0 ≤ ∑ k, W i k := fun i => Finset.sum_nonneg fun k _ => hW0 i k
  have hPnn : ∀ i, 0 ≤ P i := fun i => add_nonneg (hrow0 i) (hu0 i)
  have hP0nn : 0 ≤ P0 := Finset.sum_nonneg fun k _ => hu0 k
  have hSP : S + P0 = 1 := by
    have : S = ∑ i, ∑ k, W i k + P0 := by rw [hSd, hP0d]; simp only [hPd]; rw [Finset.sum_add_distrib]
    linarith
  have hcol : ∀ j, ∑ i, W i j = ∑ k, W j k := fun j => Finset.sum_congr rfl fun i _ => hsym i j
  have hWle : ∀ i j, W i j ≤ ∑ k, W j k := fun i j => by
    rw [hsym i j]; exact Finset.single_le_sum (fun k _ => hW0 j k) (Finset.mem_univ i)
  have huP : ∀ i, u i ≤ P i := fun i => by simp only [hPd]; linarith [hrow0 i]
  have huP0 : ∀ i, u i ≤ P0 := fun i => Finset.single_le_sum (fun k _ => hu0 k) (Finset.mem_univ i)
  have hPhalf : ∀ i, P i ≤ 1 / 2 := by
    intro i
    have h1 : ∑ k, W i k ≤ ∑ k, (P k - if k = i then P k else 0) := Finset.sum_le_sum fun k _ => by
      split_ifs with h
      · rw [h, hdiag]; simp
      · have := hWle i k; have := hu0 k; simp only [hPd]; linarith
    rw [Finset.sum_sub_distrib, Finset.sum_ite_eq', if_pos (Finset.mem_univ _)] at h1
    have : P i = ∑ k, W i k + u i := rfl
    linarith [huP0 i]
  have hShalf : 1 / 2 ≤ S := by
    have : P0 ≤ S := Finset.sum_le_sum fun i _ => huP i
    linarith
  have hS0 : 0 < S := by linarith
  have hs_hi : s ≤ S / 2 := by
    have : ∀ i, P i ^ 2 ≤ P i * (1 / 2) := fun i => by nlinarith [hPnn i, hPhalf i]
    calc s = ∑ i, P i ^ 2 := rfl
      _ ≤ ∑ i, P i * (1 / 2) := Finset.sum_le_sum fun i _ => this i
      _ = S / 2 := by rw [← Finset.sum_mul]; ring
  have hs_lo : S ^ 2 / m ≤ s := by
    have := sq_sum_le_card_mul_sum_sq (s := Finset.univ) (f := P)
    rw [Finset.card_univ, Fintype.card_fin] at this
    push_cast at this
    rw [div_le_iff₀ (by linarith)]
    have e : ∀ x : ℝ, ((t : ℝ) + 6 + 1) * x = x * m := fun x => by rw [hm]; ring
    linarith [e s]
  have hs0 : 0 < s := lt_of_lt_of_le (by positivity) hs_lo
  -- constants
  have hTo := side_To t
  have hTn := side_Tn t
  have hal := side_al2 t
  have hbo := side_bo t
  have hcp := side_cpo t
  have hcp0 := side_cpo_pos t
  have hbt := side_bt0 t
  set β : Fin (t + 6 + 1) → ℝ := fun i => bo m * (1 - cpo m * P i) with hβd
  have hβp : ∀ i, 0 < β i := fun i => mul_pos hbo (by nlinarith [hPhalf i, hPnn i])
  set K : ℝ := To m * bo m * cpo m / (2 * (m - 1)) with hKd
  have hK : 0 ≤ K := by
    have : 0 < m - 1 := by linarith
    positivity
  -- (1) the rows
  have hrows : ∀ i, ∑ j, (To m / 2 * W i j * (1 - W i j / P i) * (1 + γ i j * (1 - 2 * (W i j / P i)))
        + (Lam m - 1 / (4 * To m)) * W i j ^ 2 * (1 - γ i j ^ 2))
      ≤ To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6)
          - β i * ∑ j, W i j ^ 2 / P i) := fun i =>
    old_row t (W i) (γ i) i (P i) (hW0 i) (hdiag i) (hγ i) (by simp only [hPd]; linarith [hu0 i]) (hPhalf i)
  -- (2) the new edges
  have hnew : ∀ i, 2 * Tn m * (u i * (1 - u i / P i) * (1 - u i / P0))
      ≤ Tn m * al2 m * u i * (1 - u i / P i) ^ 2 + Tn m / al2 m * (u i * (1 - u i / P0) ^ 2) := fun i => by
    have := new_edge (u i) (1 - u i / P i) (1 - u i / P0) (al2 m) (hu0 i) hal
    have e1 : 2 * Tn m * (u i * (1 - u i / P i) * (1 - u i / P0)) = Tn m * (2 * u i * (1 - u i / P i) * (1 - u i / P0)) := by ring
    have e2 : Tn m * al2 m * u i * (1 - u i / P i) ^ 2 + Tn m / al2 m * (u i * (1 - u i / P0) ^ 2)
        = Tn m * (al2 m * u i * (1 - u i / P i) ^ 2 + u i * (1 - u i / P0) ^ 2 / al2 m) := by field_simp
    rw [e1, e2]; exact mul_le_mul_of_nonneg_left this hTn.le
  -- (3) row 0
  set c0s : ℝ := To m / 2 * bt0 m with hc0s
  have hr0 := row0 t u hu0 (c0s / (Tn m / al2 m)) (div_nonneg (by positivity) (by positivity))
    (by rw [div_le_iff₀ (by positivity)]; have := side_slope0 t; rw [← hm] at this ⊢; linarith [this])
  have hrow0b : Tn m / al2 m * ∑ i, u i * (1 - u i / P0) ^ 2 ≤ K3 m * P0 - c0s * ∑ i, u i ^ 2 / P0 := by
    have := mul_le_mul_of_nonneg_left hr0 (by positivity : 0 ≤ Tn m / al2 m)
    have e : Tn m / al2 m * ((((t : ℝ) + 6) / m) ^ 2 * P0 + c0s / (Tn m / al2 m) * (P0 / m - ∑ i, u i ^ 2 / P0))
        = K3 m * P0 - c0s * ∑ i, u i ^ 2 / P0 := by
      simp only [K3, hc0s]
      have : (t : ℝ) + 6 = m - 1 := by rw [hm]; ring
      rw [this]
      have hA : Tn m / al2 m ≠ 0 := div_ne_zero hTn.ne' hal.ne'
      have hm0 : m ≠ 0 := by linarith
      set A := Tn m / al2 m with hAd
      field_simp; ring
    rw [← hm] at this; linarith
  -- (4) the columns
  set Tc : Fin (t + 6 + 1) → ℝ := fun j => ∑ i ∈ Finset.univ.erase j, P i / β i + P0 / bt0 m with hTcd
  have hcolb : ∑ j, P j ^ 2 / Tc j ≤ ∑ i, β i * ∑ j, W i j ^ 2 / P i + bt0 m * ∑ j, u j ^ 2 / P0 := by
    have hj : ∀ j, P j ^ 2 / Tc j ≤ ∑ i, β i * W i j ^ 2 / P i + bt0 m * u j ^ 2 / P0 := by
      intro j
      rcases (hPnn j).eq_or_lt with h0 | hpos
      · rw [← h0]; simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, zero_div]
        exact add_nonneg (Finset.sum_nonneg fun i _ => div_nonneg (mul_nonneg (hβp i).le (sq_nonneg _)) (hPnn i))
          (div_nonneg (mul_nonneg hbt.le (sq_nonneg _)) hP0nn)
      exact column_cs (t + 6 + 1) (fun i => W i j) β P j (u j) P0 (bt0 m) (P j) (fun i => hW0 i j) hβp hPnn
        (fun i hi => le_antisymm (by
          have h1 := Finset.single_le_sum (fun k (_ : k ∈ Finset.univ) => hW0 i k) (Finset.mem_univ j)
          have h2 : P i = ∑ k, W i k + u i := rfl
          linarith [hu0 i]) (hW0 i j))
        (hdiag j) (hu0 j) hP0nn hbt (fun h => le_antisymm (h ▸ huP0 j) (hu0 j))
        (by simp only [hPd]; rw [hcol j]) hpos
    calc ∑ j, P j ^ 2 / Tc j ≤ ∑ j, (∑ i, β i * W i j ^ 2 / P i + bt0 m * u j ^ 2 / P0) := Finset.sum_le_sum fun j _ => hj j
      _ = ∑ i, β i * ∑ j, W i j ^ 2 / P i + bt0 m * ∑ j, u j ^ 2 / P0 := by
        rw [Finset.sum_add_distrib, Finset.sum_comm]
        congr 1
        · exact Finset.sum_congr rfl fun i _ => by rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
        · rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
  -- (5) the r-part, row by row
  set r : Fin (t + 6 + 1) → ℝ := fun i => u i / P i with hrd
  have hr1 : ∀ i, r i ≤ 1 := fun i => by
    rcases (hPnn i).eq_or_lt with h | h
    · simp [hrd, ← h]
    · exact (div_le_one h).2 (huP i)
  have hr0 : ∀ i, 0 ≤ r i := fun i => div_nonneg (hu0 i) (hPnn i)
  have hPr : ∀ i, P i * r i = u i := fun i => by
    rcases (hPnn i).eq_or_lt with h | h
    · have : u i = 0 := le_antisymm (h ▸ huP i) (hu0 i)
      simp [hrd, ← h, this]
    · simp only [hrd]; field_simp
  have hPσ : ∀ i, P i * (1 - r i) = ∑ k, W i k := fun i => by
    have := hPr i; have : P i = ∑ k, W i k + u i := rfl; linarith
  have hper : ∀ i, To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6))
        + Tn m * al2 m * u i * (1 - u i / P i) ^ 2
      = P i * psit m (r i) - K * (P i * (1 - r i)) ^ 2 := fun i => by
    rcases (hPnn i).eq_or_lt with h | h
    · have hu : u i = 0 := le_antisymm (h ▸ huP i) (hu0 i)
      rw [← h, hu]; simp
    have hσe : (∑ k, W i k) / P i = 1 - r i := by rw [← hPσ i]; field_simp
    have hu : u i = P i * r i := (hPr i).symm
    have e6 : (t : ℝ) + 6 = m - 1 := by rw [hm]; ring
    rw [hσe, e6, hu]
    have hm1 : m - 1 ≠ 0 := by intro hc; linarith
    simp only [psit, hβd, hKd, hrd]
    field_simp
    ring
  -- (6) Σ P_i ψ̃(r_i) ≤ S Ψ(r̄), by a tangent or the chord line
  set rb : ℝ := P0 / S with hrbd
  have hSrb : S * rb = P0 := by rw [hrbd]; field_simp
  have hsumPr : ∑ i, P i * r i = P0 := by rw [Finset.sum_congr rfl fun i _ => hPr i]
  -- (7) the square term
  have hsq : (2 * S - 1) ^ 2 / m ≤ ∑ i, (P i * (1 - r i)) ^ 2 := by
    have := sq_sum_le_card_mul_sum_sq (s := Finset.univ) (f := fun i => P i * (1 - r i))
    rw [Finset.card_univ, Fintype.card_fin] at this
    have hsum : ∑ i, P i * (1 - r i) = 2 * S - 1 := by
      have : ∑ i, P i * (1 - r i) = S - P0 := by
        have e : ∑ i, P i * (1 - r i) = ∑ i, (P i - P i * r i) := Finset.sum_congr rfl fun i _ => by ring
        rw [e, Finset.sum_sub_distrib, hsumPr]
      linarith
    rw [hsum] at this
    push_cast at this
    have e : ∀ x : ℝ, ((t : ℝ) + 6 + 1) * x = x * m := fun x => by rw [hm]; ring
    rw [div_le_iff₀ (by linarith)]; linarith [e (∑ i, (P i * (1 - r i)) ^ 2)]
  -- (8) the Cauchy–Schwarz term: Σ_j P_j²/Tc_j ≥ ggo
  have hTcpos : ∀ j, 0 < Tc j := fun j => by
    simp only [hTcd]
    have hβle : ∀ i, β i ≤ bo m := fun i => by
      have h := mul_nonneg hbo.le (mul_nonneg hcp0.le (hPnn i))
      have e : β i = bo m - bo m * (cpo m * P i) := by simp only [hβd]; ring
      rw [e]; linarith
    have h1 : ∀ i ∈ Finset.univ.erase j, P i / bo m ≤ P i / β i := fun i _ =>
      div_le_div_of_nonneg_left (hPnn i) (hβp i) (hβle i)
    have h2 : ∑ i ∈ Finset.univ.erase j, P i / bo m = (S - P j) / bo m := by
      rw [← Finset.sum_div]; congr 1
      have := Finset.add_sum_erase Finset.univ P (Finset.mem_univ j); linarith
    have h3 : (S - P j) / bo m + P0 / bt0 m > 0 := by
      rcases hP0nn.eq_or_lt with h0 | h0
      · have : S - P j > 0 := by linarith [hPhalf j]
        rw [← h0]; simp; exact div_pos this hbo
      · exact add_pos_of_nonneg_of_pos (div_nonneg (by linarith [hPhalf j]) hbo.le) (div_pos h0 hbt)
    linarith [Finset.sum_le_sum h1]
  have hSig : ∑ j, P j ^ 2 * Tc j = ∑ i, P i / β i * (s - P i ^ 2) + P0 * s / bt0 m := by
    have e : ∀ j, ∑ i ∈ Finset.univ.erase j, P i / β i = ∑ i, P i / β i - P j / β j := fun j => by
      have := Finset.add_sum_erase Finset.univ (fun i => P i / β i) (Finset.mem_univ j); linarith
    have e2 : ∀ j, P j ^ 2 * Tc j = (∑ i, P i / β i) * P j ^ 2 - P j ^ 3 / β j + P0 / bt0 m * P j ^ 2 := fun j => by
      simp only [hTcd, e j]; ring
    have e3 : ∀ i, P i / β i * (s - P i ^ 2) = s * (P i / β i) - P i ^ 3 / β i := fun i => by ring
    rw [Finset.sum_congr rfl fun j _ => e2 j, Finset.sum_congr rfl fun i _ => e3 i,
      Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
      ← Finset.mul_sum, ← hsd]
    ring
  set x0 : ℝ := s / S with hx0d
  have hx0 : x0 ≤ 1 / 2 := by rw [hx0d, div_le_iff₀ hS0]; linarith
  have hcx : ∀ x, 0 ≤ x → x ≤ 1 / 2 → cpo m * x < 1 := fun x h0 h1 => by nlinarith
  have hphi : ∑ i, P i / β i * (s - P i ^ 2)
      ≤ S * ((s - x0 ^ 2) / (bo m * (1 - cpo m * x0))) := by
    have ht := fun i => phi_tangent (bo m) (cpo m) s (P i) x0 hbo (hcx (P i) (hPnn i) (hPhalf i))
      (hcx x0 (div_nonneg hs0.le hS0.le) hx0) (by nlinarith [hcp, hcp0, hs_hi, hShalf])
    have hsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => mul_le_mul_of_nonneg_left (ht i) (hPnn i)
    have e1 : ∀ i, P i / β i * (s - P i ^ 2) = P i * ((s - P i ^ 2) / (bo m * (1 - cpo m * P i))) := fun i => by
      simp only [hβd]; ring
    rw [Finset.sum_congr rfl fun i _ => e1 i]
    refine le_trans hsum (le_of_eq ?_)
    set φ0 := (s - x0 ^ 2) / (bo m * (1 - cpo m * x0)) with hφ0
    set d := (-2 * x0 * (1 - cpo m * x0) + cpo m * (s - x0 ^ 2)) / (bo m * (1 - cpo m * x0) ^ 2) with hdd
    have e : ∀ i, P i * (φ0 + d * (P i - x0)) = φ0 * P i + d * (P i ^ 2 - x0 * P i) := fun i => by ring
    have hsx : s - x0 * S = 0 := by rw [hx0d]; field_simp; ring
    rw [Finset.sum_congr rfl fun i _ => e i, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
      Finset.sum_sub_distrib, ← Finset.mul_sum, ← hSd, ← hsd, hsx]
    ring
  have hDpos : 0 < ∑ j, P j ^ 2 * Tc j := by
    obtain ⟨j, hj⟩ : ∃ j, 0 < P j := by
      by_contra hc; push Not at hc
      have : S ≤ 0 := Finset.sum_nonpos fun i _ => hc i
      linarith
    have := Finset.single_le_sum (fun k (_ : k ∈ Finset.univ) => mul_nonneg (sq_nonneg (P k)) (hTcpos k).le) (Finset.mem_univ j)
    have := mul_pos (pow_pos hj 2) (hTcpos j)
    linarith
  have htitu : s ^ 2 / ∑ j, P j ^ 2 * Tc j ≤ ∑ j, P j ^ 2 / Tc j := by
    set J := Finset.univ.filter (fun j => 0 < P j) with hJ
    have hJpos : ∀ j ∈ J, 0 < P j ^ 2 * Tc j := fun j hj => by
      simp only [hJ, Finset.mem_filter, Finset.mem_univ, true_and] at hj; exact mul_pos (pow_pos hj 2) (hTcpos j)
    have h := sq_sum_div_le_sum_sq_div J (fun j => P j ^ 2) hJpos
    have hz : ∀ j, ¬ 0 < P j → P j = 0 := fun j h => le_antisymm (not_lt.1 h) (hPnn j)
    have hsJ : ∑ j ∈ J, P j ^ 2 = s := by
      simp only [hsd, hJ]; rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun j _ => ?_
      split_ifs with h
      · rfl
      · rw [hz j h]; ring
    have hDJ : ∑ j ∈ J, P j ^ 2 * Tc j = ∑ j, P j ^ 2 * Tc j := by
      rw [hJ, Finset.sum_filter]
      refine Finset.sum_congr rfl fun j _ => ?_
      split_ifs with h
      · rfl
      · rw [hz j h]; ring
    have hRJ : ∑ j ∈ J, (P j ^ 2) ^ 2 / (P j ^ 2 * Tc j) ≤ ∑ j, P j ^ 2 / Tc j := by
      calc ∑ j ∈ J, (P j ^ 2) ^ 2 / (P j ^ 2 * Tc j) = ∑ j ∈ J, P j ^ 2 / Tc j :=
            Finset.sum_congr rfl fun j hj => by
              simp only [hJ, Finset.mem_filter, Finset.mem_univ, true_and] at hj
              field_simp [(hTcpos j).ne', hj.ne']
        _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
            fun j _ _ => div_nonneg (sq_nonneg _) (hTcpos j).le
    rw [hsJ, hDJ] at h; exact le_trans h hRJ
  have hggo : ggo m S s ≤ ∑ j, P j ^ 2 / Tc j := by
    have hD : ∑ j, P j ^ 2 * Tc j ≤ S * ((s - x0 ^ 2) / (bo m * (1 - cpo m * x0))) + (1 - S) * s / bt0 m := by
      rw [hSig]; have : P0 = 1 - S := by linarith
      rw [this]; linarith [hphi]
    have hEp := enum_pos t S s hShalf (by linarith) hs_lo hs_hi
    rw [← hm] at hEp
    have hcx0 : cpo m * (s / S) < 1 := by rw [← hx0d]; exact hcx x0 (div_nonneg hs0.le hS0.le) hx0
    have hkey := ggo_mul m S s hS0 hcx0 hEp.ne' hbt hbo
    have hg0 : 0 ≤ ggo m S s := by
      unfold ggo
      have : 0 < S - cpo m * s := by
        have : cpo m * s < S := by
          have := hcx0; rw [mul_div_assoc'] at this; rwa [div_lt_one hS0] at this
        linarith
      exact div_nonneg (by positivity) hEp.le
    have h1 : ggo m S s * ∑ j, P j ^ 2 * Tc j ≤ s ^ 2 := by
      have := mul_le_mul_of_nonneg_left (by simp only [hx0d] at hD; exact hD) hg0
      linarith [hkey]
    have h2 : ggo m S s ≤ s ^ 2 / ∑ j, P j ^ 2 * Tc j := by rw [le_div_iff₀ hDpos]; exact h1
    exact le_trans h2 htitu
  -- (9) assemble
  have hrowsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => hrows i
  have hnewsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => hnew i
  have hpersum : ∑ i, (To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6))
        + Tn m * al2 m * u i * (1 - u i / P i) ^ 2)
      = ∑ i, P i * psit m (r i) - K * ∑ i, (P i * (1 - r i)) ^ 2 := by
    rw [Finset.sum_congr rfl fun i _ => hper i, Finset.sum_sub_distrib, Finset.mul_sum]
  have hSs : P0 = 1 - S := by linarith
  have hrb : rb = (1 - S) / S := by rw [hrbd, hSs]
  have hK' : To m * bo m * cpo m / (2 * (m - 1) * m) = K / m := by
    rw [hKd]; field_simp
  -- the r-part, by branch
  have hgoal : ∀ Ψ : ℝ, ∑ i, P i * psit m (r i) ≤ S * Ψ →
      ∑ i, ∑ j, (To m / 2 * W i j * (1 - W i j / P i) * (1 + γ i j * (1 - 2 * (W i j / P i)))
          + (Lam m - 1 / (4 * To m)) * W i j ^ 2 * (1 - γ i j ^ 2))
        + 2 * Tn m * ∑ i, u i * (1 - u i / P i) * (1 - u i / P0)
        + 1 / (4 * To m) * (S ^ 2 - s) + P0 * S / (2 * Tn m) + Lam m * s
      ≤ S * Ψ + PhiRest m S s := by
    intro Ψ hΨ
    have hsplit : ∑ i, (To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6)
          - β i * ∑ j, W i j ^ 2 / P i))
        = ∑ i, (To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6)))
          - To m / 2 * ∑ i, β i * ∑ j, W i j ^ 2 / P i := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
    have hnewsplit : ∑ i, (Tn m * al2 m * u i * (1 - u i / P i) ^ 2 + Tn m / al2 m * (u i * (1 - u i / P0) ^ 2))
        = ∑ i, Tn m * al2 m * u i * (1 - u i / P i) ^ 2 + Tn m / al2 m * ∑ i, u i * (1 - u i / P0) ^ 2 := by
      rw [Finset.sum_add_distrib, Finset.mul_sum]
    have hnewl : 2 * Tn m * ∑ i, u i * (1 - u i / P i) * (1 - u i / P0)
        = ∑ i, 2 * Tn m * (u i * (1 - u i / P i) * (1 - u i / P0)) := by rw [Finset.mul_sum]
    have hsum2 : ∑ i, (To m / 2 * (P i * Gu m ((∑ k, W i k) / P i) + P i * β i * ((∑ k, W i k) / P i) ^ 2 / ((t : ℝ) + 6)))
          + ∑ i, Tn m * al2 m * u i * (1 - u i / P i) ^ 2
        = ∑ i, P i * psit m (r i) - K * ∑ i, (P i * (1 - r i)) ^ 2 := by
      rw [← hpersum, ← Finset.sum_add_distrib]
    have hcs : To m / 2 * ggo m S s ≤ To m / 2 * (∑ i, β i * ∑ j, W i j ^ 2 / P i + bt0 m * ∑ j, u j ^ 2 / P0) :=
      mul_le_mul_of_nonneg_left (le_trans hggo hcolb) (by linarith)
    have hc0 : c0s * ∑ i, u i ^ 2 / P0 = To m / 2 * (bt0 m * ∑ j, u j ^ 2 / P0) := by rw [hc0s]; ring
    have hKsq : K * ((2 * S - 1) ^ 2 / m) ≤ K * ∑ i, (P i * (1 - r i)) ^ 2 := mul_le_mul_of_nonneg_left hsq hK
    have hPR : PhiRest m S s = -(K / m) * (2 * S - 1) ^ 2 - To m / 2 * ggo m S s + K3 m * (1 - S)
        + (S ^ 2 - s) / (4 * To m) + (1 - S) * S / (2 * Tn m) + Lam m * s := by
      simp only [PhiRest]; rw [hK']
    rw [hPR, hnewl]
    have e1 : 1 / (4 * To m) * (S ^ 2 - s) = (S ^ 2 - s) / (4 * To m) := by ring
    have e2 : P0 * S / (2 * Tn m) = (1 - S) * S / (2 * Tn m) := by rw [hSs]
    have e3 : K / m * (2 * S - 1) ^ 2 = K * ((2 * S - 1) ^ 2 / m) := by ring
    rw [e1, e2]
    have hK3 : K3 m * P0 = K3 m * (1 - S) := by rw [hSs]
    linarith [hrowsum, hnewsum, hsplit, hnewsplit, hsum2, hcs, hc0, hKsq, hrow0b, hΨ, e3, hSs, hK3]
  change ∑ i, ∑ j, (To m / 2 * W i j * (1 - W i j / P i) * (1 + γ i j * (1 - 2 * (W i j / P i)))
          + (Lam m - 1 / (4 * To m)) * W i j ^ 2 * (1 - γ i j ^ 2))
        + 2 * Tn m * ∑ i, u i * (1 - u i / P i) * (1 - u i / P0)
        + 1 / (4 * To m) * (S ^ 2 - s) + P0 * S / (2 * Tn m) + Lam m * s ≤ C0 m
  rcases le_or_gt rb (r1 m) with hb | hb
  · -- tangent branch
    have hΨ : ∑ i, P i * psit m (r i) ≤ S * psit m rb := by
      have ht := fun i => psit_tangent m (r i) rb hm7 (hr1 i) hb
      have hs := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => mul_le_mul_of_nonneg_left (ht i) (hPnn i)
      refine le_trans hs (le_of_eq ?_)
      have hz : ∑ i, P i * (r i - rb) = 0 := by
        have e : ∑ i, P i * (r i - rb) = ∑ i, P i * r i - (∑ i, P i) * rb := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
        rw [e, hsumPr, ← hSd, hSrb]; ring
      have e : ∑ i, P i * (psit m rb + dpsit m rb * (r i - rb))
          = psit m rb * (∑ i, P i) + dpsit m rb * ∑ i, P i * (r i - rb) := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
      rw [e, hz, ← hSd]; ring
    have := hgoal _ hΨ
    rw [hrb] at this
    have hc := closing_cubic t S s hShalf (by linarith) hs_lo hs_hi
    rw [← hm] at hc
    linarith
  · -- chord branch
    have hΨ : ∑ i, P i * psit m (r i) ≤ S * tline m rb := by
      have hl := fun i => psit_line m (r i) hm7 (hr1 i)
      have hs := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => mul_le_mul_of_nonneg_left (hl i) (hPnn i)
      refine le_trans hs (le_of_eq ?_)
      simp only [tline]
      have e : ∀ i, P i * (psit m (r1 m) * (1 - r i) / (1 - r1 m)) = psit m (r1 m) / (1 - r1 m) * (P i - P i * r i) :=
        fun i => by ring
      rw [Finset.sum_congr rfl fun i _ => e i, ← Finset.mul_sum, Finset.sum_sub_distrib, hsumPr, ← hSd]
      rw [show S - P0 = S * (1 - rb) by rw [← hSrb]; ring]
      ring
    have hS23 : S ≤ 2 / 3 := by
      have h12 : 1 / 2 < r1 m := by
        simp only [r1]; rw [lt_div_iff₀ (by nlinarith)]; nlinarith
      have : 1 / 2 < (1 - S) / S := by rw [← hrb]; linarith
      rw [lt_div_iff₀ hS0] at this; linarith
    have := hgoal _ hΨ
    rw [hrb] at this
    have hc := closing_line t S s hShalf hS23 hs_lo hs_hi
    rw [← hm] at hc
    linarith

end HamiltonsCubic.OddMW
