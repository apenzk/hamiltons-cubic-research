-- the unifier unfolds `ggo` against a product of four atoms
/-- `ggo · D = s²`, `D` the Cauchy–Schwarz denominator after Jensen. -/
theorem ggo_mul (m S s : ℝ) (hS : 0 < S) (hcs : cpo m * (s / S) < 1)
    (hE : alo m S - beo m S * s ≠ 0) (hbt : 0 < bt0 m) (hbo : 0 < bo m) :
    ggo m S s * (S * ((s - (s / S) ^ 2) / (bo m * (1 - cpo m * (s / S)))) + (1 - S) * s / bt0 m) = s ^ 2 := by
  have hlt : cpo m * s < S := by
    have h : cpo m * s / S < 1 := by rw [mul_div_assoc]; exact hcs
    rwa [div_lt_one hS] at h
  have hq : S - cpo m * s ≠ 0 := by intro h; linarith
  have hD := D_eq m S s hS hq hbt hbo
  rw [hD]
  have hb := hbo.ne'
  have hB := hbt.ne'
  have key : ∀ (E q b B : ℝ), E ≠ 0 → q ≠ 0 → b ≠ 0 → B ≠ 0 →
      s * q * b * B / E * (s * E / (b * B * q)) = s ^ 2 := by
    intro E q b B h1 h2 h3 h4; field_simp
  have := key (alo m S - beo m S * s) (S - cpo m * s) (bo m) (bt0 m) hE hq hb hB
  unfold ggo
  exact this

