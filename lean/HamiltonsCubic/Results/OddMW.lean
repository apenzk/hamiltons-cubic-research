  have h1 : m - 2 ≠ 0 := by intro h; linarith
  have h2 : m - 1 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h5 : 2 * m - 3 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  have h6 : 2 * m ^ 2 - 5 * m + 1 ≠ 0 := by nlinarith
  have h6' := h6
  ring_nf at h6'
  have h7 : m - 3 ≠ 0 := by intro h; linarith
  have hS' : S ≠ 0 := hS.ne'
  have hq' := hq.ne'
  have hq'' := hq.ne'
  simp only [quad0P] at hq' hq''
  ring_nf at hq''
  have hr1e : 1 - r1 m = (2 * m - 1) * (m - 3) / (2 * (2 * m ^ 2 - 5 * m + 1)) := by
    simp only [r1]; set D := 2 * m ^ 2 - 5 * m + 1 with hD; field_simp; rw [hD]; ring
  simp only [PhiRest, ggo, tline]
  rw [enum0_eq m S hm, hr1e]
  simp only [psit, Gu, r1, To, Tn, Lam, C0, K3, al2, bt0, bo, cpo]
  set D := 2 * m ^ 2 - 5 * m + 1 with hD
  set Q := quad0P m S with hQd
  field_simp
  rw [hD, hQd]
  simp only [QlP, quad0P]
  ring

theorem closing_line (t : ℕ) (S s : ℝ) (hS0 : 1 / 2 ≤ S) (hS1 : S ≤ 2 / 3)
    (hs0 : S ^ 2 / ((t : ℝ) + 7) ≤ s) (hs1 : s ≤ S / 2) :
    S * tline ((t : ℝ) + 7) ((1 - S) / S) + PhiRest ((t : ℝ) + 7) S s ≤ C0 ((t : ℝ) + 7) := by
  have hmono := ggo_mono t S s hS0 (by linarith) hs0 hs1
  have hq0 := cert_enum0 t S hS0 (by linarith)
  have hQ := cert_Ql t S hS0 hS1
  simp only at hq0 hQ
  set m : ℝ := (t : ℝ) + 7 with hm
  have hm7 : 7 ≤ m := by rw [hm]; have : (0 : ℝ) ≤ t := t.cast_nonneg; linarith
  have hS : 0 < S := by linarith
  have hTo : 0 < To m := side_To t
  have hrel := kapo_rel m hm7
  have hPR : PhiRest m S s ≤ PhiRest m S (S ^ 2 / m) := by
    have key : PhiRest m S s - PhiRest m S (S ^ 2 / m)
        = -(To m / 2) * (ggo m S s - ggo m S (S ^ 2 / m) - kapo m * (s - S ^ 2 / m)) := by
      simp only [PhiRest]; linear_combination (-(s - S ^ 2 / m)) * hrel
    have : 0 ≤ To m / 2 * (ggo m S s - ggo m S (S ^ 2 / m) - kapo m * (s - S ^ 2 / m)) :=
      mul_nonneg (by linarith) (by linarith)
    linarith
  have hid := closeL_eq m S hm7 hS hq0
  have hpos : 0 ≤ QlP m S / (32 * m ^ 2 * (m - 2) * (m - 1) ^ 2 * (2 * m - 3) * (2 * m - 1) ^ 2
      * (2 * m ^ 2 - 5 * m + 1) * quad0P m S) := by
    apply div_nonneg hQ
    have a1 : 0 < m - 2 := by linarith
    have a2 : 0 < m - 1 := by linarith
    have a3 : 0 < 2 * m - 3 := by linarith
    have a4 : 0 < 2 * m - 1 := by linarith
    have a5 : 0 < 2 * m ^ 2 - 5 * m + 1 := by nlinarith
    have a6 : 0 < m := by linarith
    exact (mul_pos (mul_pos (mul_pos (mul_pos (mul_pos (mul_pos (mul_pos (by norm_num) (pow_pos a6 2)) a1) (pow_pos a2 2)) a3) (pow_pos a4 2)) a5) hq0).le
  linarith

/-! ### Elementary bounds -/

/-- Cauchy–Schwarz with two terms. -/
theorem cs2 (a b A B X Y : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) (hX : 0 ≤ X) (hY : 0 ≤ Y)
    (ha : a ^ 2 ≤ A * X) (hb : b ^ 2 ≤ B * Y) : (a + b) ^ 2 ≤ (A + B) * (X + Y) := by
  have hsum : 0 ≤ A * Y + B * X := by positivity
  have h1 : (2 * (a * b)) ^ 2 ≤ (A * Y + B * X) ^ 2 := by
    have h2 : a ^ 2 * b ^ 2 ≤ (A * X) * (B * Y) := mul_le_mul ha hb (sq_nonneg _) (by positivity)
    nlinarith [sq_nonneg (A * Y - B * X)]
  have key : 2 * (a * b) ≤ A * Y + B * X := by
    by_contra hc
    push Not at hc
    have := mul_pos (sub_pos.2 hc) (by linarith : 0 < 2 * (a * b) + (A * Y + B * X))
    nlinarith
  nlinarith [key]

/-- `ψ̃'`. -/
noncomputable def dpsit (m rb : ℝ) : ℝ :=
  (2 * m - 1) ^ 2 * (6 * m ^ 2 * rb ^ 2 - 8 * m ^ 2 * rb - 15 * m * rb ^ 2 + 16 * m * rb + 3 * m + 3 * rb ^ 2 - 5)
    / (8 * m * (m - 1) ^ 2 * (2 * m - 3))

/-- The tangent of `ψ̃` at `r̄ ≤ r₁` lies above it on `[0, 1]`. -/
theorem psit_tangent (m r rb : ℝ) (hm : 7 ≤ m) (hr1 : r ≤ 1) (hrb : rb ≤ r1 m) :
    psit m r ≤ psit m rb + dpsit m rb * (r - rb) := by
  unfold dpsit
  have h1 : m - 1 ≠ 0 := by intro h; linarith
  have h2 : 2 * m - 3 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  have h5 : 2 * m ^ 2 - 5 * m + 1 ≠ 0 := by nlinarith
  have h5' := h5
  ring_nf at h5'
  have e : psit m r - (psit m rb
      + (2 * m - 1) ^ 2 * (6 * m ^ 2 * rb ^ 2 - 8 * m ^ 2 * rb - 15 * m * rb ^ 2 + 16 * m * rb + 3 * m + 3 * rb ^ 2 - 5)
        / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) * (r - rb))
      = (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) * (r - rb) ^ 2
        * (r - (2 * r1 m + 1 - 2 * rb)) := by
    simp only [psit, Gu, To, Tn, al2, bo, r1]; set D := 2 * m ^ 2 - 5 * m + 1 with hD; field_simp; rw [hD]; ring
  have hc : 0 ≤ (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) := by
    apply div_nonneg (mul_nonneg (sq_nonneg _) (by nlinarith))
    have : 0 < m - 1 := by linarith
    have : 0 < 2 * m - 3 := by linarith
    positivity
  have hr1' : 1 ≤ r1 m + (1 / 2) := by
    simp only [r1]; rw [← sub_nonneg]
    have e2 : (2 * m ^ 2 - 3 * m - 1) / (2 * (2 * m ^ 2 - 5 * m + 1)) + 1 / 2 - 1
        = (m - 1) / (2 * m ^ 2 - 5 * m + 1) := by set D := 2 * m ^ 2 - 5 * m + 1 with hD; field_simp; rw [hD]; ring
    rw [e2]; apply div_nonneg <;> nlinarith
  have hneg : r - (2 * r1 m + 1 - 2 * rb) ≤ 0 := by linarith
  have : (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) * (r - rb) ^ 2
      * (r - (2 * r1 m + 1 - 2 * rb)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hc (sq_nonneg _)) hneg
  linarith

/-- The line through `(r₁, ψ̃(r₁))` and `(1, 0)` lies above `ψ̃` on `[0, 1]`. -/
theorem psit_line (m r : ℝ) (hm : 7 ≤ m) (hr1 : r ≤ 1) : psit m r ≤ tline m r := by
  have h1 : m - 1 ≠ 0 := by intro h; linarith
  have h2 : 2 * m - 3 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  have h5 : 2 * m ^ 2 - 5 * m + 1 ≠ 0 := by nlinarith
  have h5' := h5
  ring_nf at h5'
  have h6 : m - 3 ≠ 0 := by intro h; linarith
  have hr1e : 1 - r1 m = (2 * m - 1) * (m - 3) / (2 * (2 * m ^ 2 - 5 * m + 1)) := by
    simp only [r1]; set D := 2 * m ^ 2 - 5 * m + 1 with hD; field_simp; rw [hD]; ring
  have e : psit m r - tline m r
      = (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) * (r - r1 m) ^ 2 * (r - 1) := by
    simp only [tline]; rw [hr1e]; simp only [psit, Gu, To, Tn, al2, bo, r1]; set D := 2 * m ^ 2 - 5 * m + 1 with hD; field_simp; rw [hD]; ring
  have hc : 0 ≤ (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) := by
    apply div_nonneg (mul_nonneg (sq_nonneg _) (by nlinarith))
    have : 0 < m - 1 := by linarith
    have : 0 < 2 * m - 3 := by linarith
    positivity
  have : (2 * m - 1) ^ 2 * (2 * m ^ 2 - 5 * m + 1) / (8 * m * (m - 1) ^ 2 * (2 * m - 3)) * (r - r1 m) ^ 2 * (r - 1) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hc (sq_nonneg _)) (by linarith)
  linarith

/-- The tangent of the concave `φ(x) = (s − x²)/(b(1 − c x))` at `x₀` lies above it. -/
theorem phi_tangent (b c s x x0 : ℝ) (hb : 0 < b) (hx : c * x < 1) (hx0 : c * x0 < 1) (hcs : c ^ 2 * s ≤ 1) :
    (s - x ^ 2) / (b * (1 - c * x))
      ≤ (s - x0 ^ 2) / (b * (1 - c * x0)) + (-2 * x0 * (1 - c * x0) + c * (s - x0 ^ 2)) / (b * (1 - c * x0) ^ 2) * (x - x0) := by
  have h1 : 0 < 1 - c * x := by linarith
  have h2 : 0 < 1 - c * x0 := by linarith
  have e : (s - x ^ 2) / (b * (1 - c * x)) - ((s - x0 ^ 2) / (b * (1 - c * x0))
      + (-2 * x0 * (1 - c * x0) + c * (s - x0 ^ 2)) / (b * (1 - c * x0) ^ 2) * (x - x0))
      = -((x - x0) ^ 2 * (1 - c ^ 2 * s)) / (b * (1 - c * x) * (1 - c * x0) ^ 2) := by
    set p := 1 - c * x with hp
    set p0 := 1 - c * x0 with hp0
    field_simp
    rw [hp, hp0]; ring
  have : -((x - x0) ^ 2 * (1 - c ^ 2 * s)) / (b * (1 - c * x) * (1 - c * x0) ^ 2) ≤ 0 := by
    apply div_nonpos_of_nonpos_of_nonneg _ (by positivity)
    have := mul_nonneg (sq_nonneg (x - x0)) (by linarith : (0:ℝ) ≤ 1 - c ^ 2 * s)
    linarith
  linarith

/-! ### The walk: rows, row `0`, and the columns -/

/-- An old row, by the scaled chord at `κ_o`. -/
theorem old_row (t : ℕ) (w γ : Fin (t + 7) → ℝ) (i : Fin (t + 7)) (P : ℝ) (hw0 : ∀ j, 0 ≤ w j) (hwi : w i = 0)
    (hγ : ∀ j, 0 ≤ γ j ∧ γ j ≤ 1) (hP : ∑ k, w k ≤ P) (hP1 : P ≤ 1 / 2) :
    ∑ j, (To ((t : ℝ) + 7) / 2 * w j * (1 - w j / P) * (1 + γ j * (1 - 2 * (w j / P)))
        + (Lam ((t : ℝ) + 7) - 1 / (4 * To ((t : ℝ) + 7))) * w j ^ 2 * (1 - γ j ^ 2))
      ≤ To ((t : ℝ) + 7) / 2 * (P * Gu ((t : ℝ) + 7) ((∑ k, w k) / P)
          + P * (bo ((t : ℝ) + 7) * (1 - cpo ((t : ℝ) + 7) * P)) * ((∑ k, w k) / P) ^ 2 / ((t : ℝ) + 6)
          - bo ((t : ℝ) + 7) * (1 - cpo ((t : ℝ) + 7) * P) * ∑ j, w j ^ 2 / P) := by
  set m : ℝ := (t : ℝ) + 7 with hm
  have hT0 : (0 : ℝ) ≤ t := t.cast_nonneg
  have hTo := side_To t
  have hrel := kapo_rel m (by linarith)
  have hsum0 : 0 ≤ ∑ k, w k := Finset.sum_nonneg fun k _ => hw0 k
  rcases eq_or_lt_of_le (hsum0.trans hP) with hP0 | hPp
  · -- an empty row
    have hwz : ∀ j, w j = 0 := fun j => by
      have := Finset.single_le_sum (fun k _ => hw0 k) (Finset.mem_univ j)
      exact le_antisymm (by linarith [hP0 ▸ hP]) (hw0 j)
    simp [hwz, ← hP0]
  set σ := (∑ k, w k) / P with hσ
  have hσ0 : 0 ≤ σ := div_nonneg hsum0 hPp.le
  have hσ1 : σ ≤ 1 := by rw [hσ, div_le_one hPp]; exact hP
  set q : Fin (t + 7) → ℝ := fun j => w j / P with hq
  -- each entry is (To/2) P times L276's entry at κ_o
  have eterm : ∀ j, To m / 2 * w j * (1 - w j / P) * (1 + γ j * (1 - 2 * (w j / P)))
      + (Lam m - 1 / (4 * To m)) * w j ^ 2 * (1 - γ j ^ 2)
      = To m / 2 * P * (q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + kapo m * P * q j ^ 2 * (1 - γ j ^ 2)) := by
    intro j; rw [← hrel]; simp only [hq]; field_simp
  rw [Finset.sum_congr rfl fun j _ => eterm j, ← Finset.mul_sum]
  -- drop the diagonal slot
  have hsplit : ∀ f : Fin (t + 7) → ℝ, ∑ j, f j = f i + ∑ k, f (i.succAbove k) := fun f => Fin.sum_univ_succAbove f i
  have hqi : q i = 0 := by simp [hq, hwi]
  have hqs : ∑ k, q (i.succAbove k) = σ := by
    have : ∑ j, q j = σ := by simp only [hq, hσ]; rw [Finset.sum_div]
    rw [hsplit q, hqi, zero_add] at this; exact this
  have hch := scaled_row_chord (t + 6) (by omega) (kapo m) P σ (by
      simp only [kapo]; exact div_nonneg (mul_nonneg (mul_nonneg (by positivity) (by linarith)) (by linarith)) (by positivity)) (side_kap t) hPp.le hP1 hσ0 hσ1
    (fun k => q (i.succAbove k)) (fun k => γ (i.succAbove k))
    (fun k => div_nonneg (hw0 _) hPp.le) hqs (fun k => hγ _)
  have hn6 : ((t + 6 : ℕ) : ℝ) = (t : ℝ) + 6 := by push_cast; ring
  rw [hn6] at hch
  rw [hsplit (fun j => q j * (1 - q j) * (1 + γ j * (1 - 2 * q j)) + kapo m * P * q j ^ 2 * (1 - γ j ^ 2)), hqi]
  have hsq : ∑ j, w j ^ 2 / P = P * (∑ k, q (i.succAbove k) ^ 2) := by
    have h1 : ∀ j, w j ^ 2 / P = P * q j ^ 2 := fun j => by simp only [hq]; field_simp
    rw [Finset.sum_congr rfl fun j _ => h1 j, ← Finset.mul_sum, hsplit (fun j => q j ^ 2), hqi]; ring
  rw [hsq]
  have hbeta : bo m * (1 - cpo m * P) = 2 * ((t : ℝ) + 6 - 1) / ((t : ℝ) + 6) - ((t : ℝ) + 6) * kapo m * P / ((t : ℝ) + 6 - 1) := by
    have e6 : (t : ℝ) + 6 = m - 1 := by rw [hm]; ring
    rw [e6]
    have h1 : m - 2 ≠ 0 := by intro h; rw [hm] at h; linarith
    have h2 : m - 1 ≠ 0 := by intro h; rw [hm] at h; linarith
    have h3 : 2 * m - 1 ≠ 0 := by intro h; rw [hm] at h; linarith
    have h4 : m - 1 - 1 ≠ 0 := by intro h; rw [hm] at h; linarith
    clear_value m
    simp only [bo, cpo, kapo]; field_simp; ring
  have hGu : Gu m σ = 2 * σ * (1 - σ / ((t : ℝ) + 6)) ^ 2 := by simp only [Gu, hm]; ring
  rw [hGu, hbeta]
  have e0 : (0 : ℝ) * (1 - 0) * (1 + γ i * (1 - 2 * 0)) + kapo m * P * 0 ^ 2 * (1 - γ i ^ 2) = 0 := by ring
  rw [e0, zero_add]
  have hK : 0 ≤ To m / 2 * P := by positivity
  have hmul := mul_le_mul_of_nonneg_left hch hK
  refine le_trans (le_of_eq (by ring)) (le_trans hmul (le_of_eq (by ring)))

/-- The new edges, by a weighted AM-GM. -/
theorem new_edge (u a b al : ℝ) (hu : 0 ≤ u) (hal : 0 < al) :
    2 * u * a * b ≤ al * u * a ^ 2 + u * b ^ 2 / al := by
  have : 0 ≤ u * (al * a - b) ^ 2 / al := by positivity
  have e : u * (al * a - b) ^ 2 / al = al * u * a ^ 2 + u * b ^ 2 / al - 2 * u * a * b := by field_simp; ring
  linarith

/-- Row `0`, by `R0` on `m` slots with every `γ = 1`, at any slope `c ≤ (m − 1)/m`. -/
theorem row0 (t : ℕ) (u : Fin (t + 7) → ℝ) (hu0 : ∀ i, 0 ≤ u i) (c : ℝ) (hc0 : 0 ≤ c)
    (hc1 : c ≤ ((t : ℝ) + 6) / ((t : ℝ) + 7)) :
    ∑ i, u i * (1 - u i / ∑ k, u k) ^ 2
      ≤ (((t : ℝ) + 6) / ((t : ℝ) + 7)) ^ 2 * ∑ k, u k + c * ((∑ k, u k) / ((t : ℝ) + 7) - ∑ i, u i ^ 2 / ∑ k, u k) := by
  set P0 := ∑ k, u k with hP0
  set m : ℝ := (t : ℝ) + 7 with hm
  have hT0 : (0 : ℝ) ≤ t := t.cast_nonneg
  have hm0 : 0 < m := by linarith
  by_cases hz : P0 = 0
  · have huz : ∀ i, u i = 0 := fun i => by
      have := Finset.single_le_sum (fun k (_ : k ∈ Finset.univ) => hu0 k) (Finset.mem_univ i)
      exact le_antisymm (by rw [← hP0, hz] at this; exact this) (hu0 i)
    simp [huz, hz]
  have hpos : 0 < P0 := lt_of_le_of_ne (Finset.sum_nonneg fun k (_ : k ∈ Finset.univ) => hu0 k) (Ne.symm hz)
  set q : Fin (t + 7) → ℝ := fun i => u i / P0 with hq
  have hqs : ∑ i, q i = 1 := by simp only [hq]; rw [← Finset.sum_div, div_self hpos.ne']
  have hR := R0 (t + 7) (by omega) q (fun _ => 1) (fun i => div_nonneg (hu0 i) hpos.le) hqs (fun _ => ⟨by norm_num, le_rfl⟩)
  have hsl : MWPrime.slope ((t + 7 : ℕ) : ℝ) 0 = 2 * (m - 1) / m := by simp [MWPrime.slope, hm]
  rw [hsl] at hR
  -- ρ ≥ 1/m
  have hρ : 1 / m ≤ ∑ i, q i ^ 2 := by
    have := sq_sum_le_card_mul_sum_sq (s := Finset.univ) (f := q)
    rw [hqs, Finset.card_univ, Fintype.card_fin] at this
    push_cast at this
    rw [div_le_iff₀ hm0]; linarith
  have hsum : ∑ i, q i * (1 - q i) ^ 2 ≤ ((m - 1) / m) ^ 2 + c * (1 / m - ∑ i, q i ^ 2) := by
    have e : ∑ i, q i * (1 - q i) * (1 + 1 * (1 - 2 * q i)) = 2 * ∑ i, q i * (1 - q i) ^ 2 := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by ring
    rw [e] at hR
    have hc1' : c ≤ (m - 1) / m := by rw [hm]; convert hc1 using 1; ring
    have e : (m - 1) / m * (1 - ∑ i, q i ^ 2) = ((m - 1) / m) ^ 2 + (m - 1) / m * (1 / m - ∑ i, q i ^ 2) := by
      field_simp; ring
    have h3 : ((m - 1) / m - c) * (1 / m - ∑ i, q i ^ 2) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith)
    have e3 : ((m - 1) / m - c) * (1 / m - ∑ i, q i ^ 2)
        = (m - 1) / m * (1 / m - ∑ i, q i ^ 2) - c * (1 / m - ∑ i, q i ^ 2) := by ring
    have h4 : ∑ i, q i * (1 - q i) ^ 2 ≤ (m - 1) / m * (1 - ∑ i, q i ^ 2) := by
      have : 2 * (m - 1) / m * (1 - ∑ j, q j ^ 2) = 2 * ((m - 1) / m * (1 - ∑ i, q i ^ 2)) := by ring
      linarith
    linarith
  have e1 : ∑ i, u i * (1 - u i / P0) ^ 2 = P0 * ∑ i, q i * (1 - q i) ^ 2 := by
    rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by simp only [hq]; field_simp
  have e2 : ∑ i, u i ^ 2 / P0 = P0 * ∑ i, q i ^ 2 := by
    rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by simp only [hq]; field_simp
  rw [e1, e2]
  have := mul_le_mul_of_nonneg_left hsum hpos.le
  have e3 : P0 * (((m - 1) / m) ^ 2 + c * (1 / m - ∑ i, q i ^ 2))
      = ((m - 1) / m) ^ 2 * P0 + c * (P0 / m - P0 * ∑ i, q i ^ 2) := by ring
  have hm6 : (t : ℝ) + 6 = m - 1 := by rw [hm]; ring
  rw [hm6]; linarith


/-- One column's Cauchy–Schwarz, with row `0`'s entry as the extra term. -/
theorem column_cs (N : ℕ) (w β P : Fin N → ℝ) (j : Fin N) (uj P0 b0' Pj : ℝ)
    (hw0 : ∀ i, 0 ≤ w i) (hβ : ∀ i, 0 < β i) (hP : ∀ i, 0 ≤ P i) (hwP : ∀ i, P i = 0 → w i = 0) (hwj : w j = 0)
    (huj : 0 ≤ uj) (hP0 : 0 ≤ P0) (hb0 : 0 < b0') (hu0 : P0 = 0 → uj = 0) (hPj : Pj = ∑ i, w i + uj) (hPjp : 0 < Pj) :
    Pj ^ 2 / (∑ i ∈ Finset.univ.erase j, P i / β i + P0 / b0')
      ≤ ∑ i, β i * w i ^ 2 / P i + b0' * uj ^ 2 / P0 := by
  set T := Finset.univ.filter (fun i => i ≠ j ∧ 0 < P i) with hT
  have hTpos : ∀ i ∈ T, 0 < P i / β i := fun i hi => by
    simp only [hT, Finset.mem_filter, Finset.mem_univ, true_and] at hi; exact div_pos hi.2 (hβ i)
  have hTw : ∑ i ∈ T, w i = ∑ i, w i := by
    rw [hT, Finset.sum_filter]
    refine Finset.sum_congr rfl fun i _ => ?_
    split_ifs with h
    · rfl
    · push Not at h
      by_cases hij : i = j
      · rw [hij, hwj]
      · exact (hwP i (le_antisymm (h hij) (hP i))).symm
  have hA : (∑ i, w i) ^ 2 ≤ (∑ i, β i * w i ^ 2 / P i) * ∑ i ∈ T, P i / β i := by
    rcases (Finset.sum_nonneg fun i (_ : i ∈ T) => (hTpos i ‹_›).le).eq_or_lt with h0 | h0
    · -- T empty in effect: every w vanishes
      have : ∑ i ∈ T, w i = 0 := by
        have hTe : T = ∅ := by
          by_contra hne
          obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.2 hne
          have := Finset.single_le_sum (fun k (hk : k ∈ T) => (hTpos k hk).le) hi
          linarith [hTpos i hi]
        rw [hTe, Finset.sum_empty]
      rw [← hTw, this, sq, zero_mul]
      exact mul_nonneg (Finset.sum_nonneg fun i _ => div_nonneg (mul_nonneg (hβ i).le (sq_nonneg _)) (hP i))
        (Finset.sum_nonneg fun i hi => (hTpos i hi).le)
    have htitu := sq_sum_div_le_sum_sq_div T (fun i => w i) hTpos
    rw [hTw] at htitu
    have hsub : ∑ i ∈ T, w i ^ 2 / (P i / β i) ≤ ∑ i, β i * w i ^ 2 / P i := by
      calc ∑ i ∈ T, w i ^ 2 / (P i / β i) = ∑ i ∈ T, β i * w i ^ 2 / P i :=
            Finset.sum_congr rfl fun i hi => by
              simp only [hT, Finset.mem_filter, Finset.mem_univ, true_and] at hi
              field_simp [(hβ i).ne', hi.2.ne']
        _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
            fun i _ _ => div_nonneg (mul_nonneg (hβ i).le (sq_nonneg _)) (hP i)
    have := (div_le_iff₀ h0).1 (le_trans htitu hsub)
    linarith
  have hB : uj ^ 2 ≤ (b0' * uj ^ 2 / P0) * (P0 / b0') := by
    rcases hP0.eq_or_lt with h | h
    · rw [hu0 h.symm]; simp
    · rw [show b0' * uj ^ 2 / P0 * (P0 / b0') = uj ^ 2 by field_simp]
  have hTle : ∑ i ∈ T, P i / β i ≤ ∑ i ∈ Finset.univ.erase j, P i / β i :=
    Finset.sum_le_sum_of_subset_of_nonneg (fun i hi => by
      simp only [hT, Finset.mem_filter, Finset.mem_univ, true_and] at hi
      exact Finset.mem_erase.2 ⟨hi.1, Finset.mem_univ _⟩) (fun i _ _ => div_nonneg (hP i) (hβ i).le)
  have hcs := cs2 (∑ i, w i) uj (∑ i, β i * w i ^ 2 / P i) (b0' * uj ^ 2 / P0) (∑ i ∈ T, P i / β i) (P0 / b0')
    (Finset.sum_nonneg fun i _ => div_nonneg (mul_nonneg (hβ i).le (sq_nonneg _)) (hP i))
    (div_nonneg (mul_nonneg hb0.le (sq_nonneg _)) hP0) (Finset.sum_nonneg fun i hi => (hTpos i hi).le)
    (div_nonneg hP0 hb0.le) hA hB
  rw [← hPj] at hcs
  have hX : 0 < ∑ i ∈ T, P i / β i + P0 / b0' := by
    by_contra hc; push Not at hc
    have h1 : 0 ≤ ∑ i, β i * w i ^ 2 / P i + b0' * uj ^ 2 / P0 :=
      add_nonneg (Finset.sum_nonneg fun i _ => div_nonneg (mul_nonneg (hβ i).le (sq_nonneg _)) (hP i))
        (div_nonneg (mul_nonneg hb0.le (sq_nonneg _)) hP0)
    have : Pj ^ 2 ≤ 0 := le_trans hcs (mul_nonpos_of_nonneg_of_nonpos h1 hc)
    nlinarith
  have hY : ∑ i ∈ T, P i / β i + P0 / b0' ≤ ∑ i ∈ Finset.univ.erase j, P i / β i + P0 / b0' := by linarith
  rw [div_le_iff₀ (lt_of_lt_of_le hX hY)]
  calc Pj ^ 2 ≤ _ := hcs
    _ ≤ _ := mul_le_mul_of_nonneg_left hY
        (add_nonneg (Finset.sum_nonneg fun i _ => div_nonneg (mul_nonneg (hβ i).le (sq_nonneg _)) (hP i))
          (div_nonneg (mul_nonneg hb0.le (sq_nonneg _)) hP0))

/-- The Cauchy–Schwarz denominator after Jensen, in closed form. -/
theorem D_eq (m S s : ℝ) (hS : 0 < S) (hq : S - cpo m * s ≠ 0) (hbt : 0 < bt0 m) (hbo : 0 < bo m) :
    S * ((s - (s / S) ^ 2) / (bo m * (1 - cpo m * (s / S)))) + (1 - S) * s / bt0 m
      = s * (alo m S - beo m S * s) / (bo m * bt0 m * (S - cpo m * s)) := by
  have hS' := hS.ne'
  have hb := hbo.ne'
  have hB := hbt.ne'
  have e1 : 1 - cpo m * (s / S) = (S - cpo m * s) / S := by field_simp
  rw [e1]
  simp only [alo, beo]
  set q := S - cpo m * s with hqd
  field_simp
  rw [hqd]; ring

