/-! ### The closing inequality in `(S, s_o)`

Every constant is a rational function of `m`; the six polynomial facts are Bernstein certificates in `S` whose
coefficients are polynomials in `t = m − 7` with non-negative coefficients (`cert_oddmw.py`). -/

noncomputable def kapo (m : ℝ) : ℝ := 4 * m ^ 2 * (2 * m - 3) * (2 * m + 3) / (2 * m - 1) ^ 4
noncomputable def bo (m : ℝ) : ℝ := 2 * (m - 2) / (m - 1)
noncomputable def cpo (m : ℝ) : ℝ := 2 * m ^ 2 * (m - 1) ^ 2 * (2 * m - 3) * (2 * m + 3) / ((m - 2) ^ 2 * (2 * m - 1) ^ 4)
noncomputable def bt0 (m : ℝ) : ℝ := 4 * m * (8 * m ^ 5 - 48 * m ^ 4 + 94 * m ^ 3 - 68 * m ^ 2 + 10 * m + 5) / ((m - 2) * (m - 1) * (2 * m - 1) ^ 4)
noncomputable def al2 (m : ℝ) : ℝ := (2 * m - 1) / (2 * m)
noncomputable def K3 (m : ℝ) : ℝ := Tn m / al2 m * ((m - 1) / m) ^ 2 + To m / 2 * bt0 m / m
noncomputable def Gu (m σ : ℝ) : ℝ := 2 * σ * (1 - σ / (m - 1)) ^ 2
noncomputable def psit (m r : ℝ) : ℝ :=
  To m / 2 * Gu m (1 - r) + Tn m * al2 m * r * (1 - r) ^ 2 + To m / (2 * (m - 1)) * bo m * (1 - r) ^ 2
noncomputable def r1 (m : ℝ) : ℝ := (2 * m ^ 2 - 3 * m - 1) / (2 * (2 * m ^ 2 - 5 * m + 1))
noncomputable def tline (m r : ℝ) : ℝ := psit m (r1 m) * (1 - r) / (1 - r1 m)
noncomputable def alo (m S : ℝ) : ℝ := S ^ 2 * bt0 m + (1 - S) * bo m * S
noncomputable def beo (m S : ℝ) : ℝ := bt0 m + (1 - S) * bo m * cpo m
noncomputable def ggo (m S s : ℝ) : ℝ := s * (S - cpo m * s) * bo m * bt0 m / (alo m S - beo m S * s)
noncomputable def PhiRest (m S s : ℝ) : ℝ :=
  -(To m * bo m * cpo m / (2 * (m - 1) * m)) * (2 * S - 1) ^ 2 - To m / 2 * ggo m S s + K3 m * (1 - S)
    + (S ^ 2 - s) / (4 * To m) + (1 - S) * S / (2 * Tn m) + Lam m * s
noncomputable def ellx (m S s s0 : ℝ) : ℝ :=
  bo m * bt0 m * (S * alo m S - cpo m * alo m S * (s + s0) + cpo m * beo m S * s * s0)
    - kapo m * (alo m S - beo m S * s) * (alo m S - beo m S * s0)

/-! ### Side conditions, each a polynomial in `t = m − 7` with non-negative coefficients -/

theorem side_kap (t : ℕ) : kapo ((t : ℝ) + 7) ≤ kap (((t + 6 : ℕ) : ℝ)) := by
  have hc : ((t + 6 : ℕ) : ℝ) = (t : ℝ) + 6 := by push_cast; ring
  rw [hc]
  set T : ℝ := (t : ℝ) with hT
  have hT0 : 0 ≤ T := t.cast_nonneg
  unfold kapo kap
  have e1 : 2 * (T + 7) - 1 = 2 * T + 13 := by ring
  rw [e1, div_le_div_iff₀ (by positivity) (by positivity)]
  have e : 2 * (T + 6 + 1) * (T + 6 - 1) ^ 2 * (2 * T + 13) ^ 4 - 4 * (T + 7) ^ 2 * (2 * (T + 7) - 3) * (2 * (T + 7) + 3) * (T + 6) ^ 3
