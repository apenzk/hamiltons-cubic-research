theorem enum0_eq (m S : ℝ) (hm : 7 ≤ m) :
    alo m S - beo m S * (S ^ 2 / m) = 2 * S * quad0P m S / ((m - 2) * (m - 1) * (2 * m - 1) ^ 4) := by
  have h1 : m - 2 ≠ 0 := by intro h; linarith
  have h2 : m - 1 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  have hd : (m - 2) * (m - 1) * (2 * m - 1) ^ 4 ≠ 0 := mul_ne_zero (mul_ne_zero h1 h2) (pow_ne_zero 4 h3)
  have kB : bt0 m * ((m - 2) * (m - 1) * (2 * m - 1) ^ 4) = 4 * m * (8 * m ^ 5 - 48 * m ^ 4 + 94 * m ^ 3 - 68 * m ^ 2 + 10 * m + 5) := by
    unfold bt0; exact div_mul_cancel₀ _ hd
  have kb : bo m * (m - 1) = 2 * (m - 2) := by unfold bo; exact div_mul_cancel₀ _ h2
  have kc : cpo m * ((m - 2) ^ 2 * (2 * m - 1) ^ 4) = 2 * m ^ 2 * (m - 1) ^ 2 * (2 * m - 3) * (2 * m + 3) := by
    unfold cpo; exact div_mul_cancel₀ _ (mul_ne_zero (pow_ne_zero 2 h1) (pow_ne_zero 4 h3))
  have km : m * m⁻¹ = 1 := mul_inv_cancel₀ h4
  rw [eq_div_iff hd]
  simp only [alo, beo, quad0P, linhP]
  linear_combination (-S^2*(m⁻¹ - 1)) * kB + (S*(S - 1)*(m - 2)*(2*m - 1)^4*(S*cpo m*m⁻¹ - 1)) * kb + (2*S^2*m⁻¹*(S - 1)) * kc + (4*S^2*(4*S*m^5 - 8*S*m^4 - 5*S*m^3 + 18*S*m^2 - 9*S*m - 12*m^5 + 56*m^4 - 89*m^3 + 50*m^2 - m - 5)) * km

theorem enumh_eq (m S : ℝ) (hm : 7 ≤ m) :
    alo m S - beo m S * (S / 2) = 2 * S * linhP m S / ((m - 2) * (m - 1) * (2 * m - 1) ^ 4) := by
  have h1 : m - 2 ≠ 0 := by intro h; linarith
  have h2 : m - 1 ≠ 0 := by intro h; linarith
  have h3 : 2 * m - 1 ≠ 0 := by intro h; linarith
  have h4 : m ≠ 0 := by intro h; linarith
  have hd : (m - 2) * (m - 1) * (2 * m - 1) ^ 4 ≠ 0 := mul_ne_zero (mul_ne_zero h1 h2) (pow_ne_zero 4 h3)
  have kB : bt0 m * ((m - 2) * (m - 1) * (2 * m - 1) ^ 4) = 4 * m * (8 * m ^ 5 - 48 * m ^ 4 + 94 * m ^ 3 - 68 * m ^ 2 + 10 * m + 5) := by
    unfold bt0; exact div_mul_cancel₀ _ hd
  have kb : bo m * (m - 1) = 2 * (m - 2) := by unfold bo; exact div_mul_cancel₀ _ h2
  have kc : cpo m * ((m - 2) ^ 2 * (2 * m - 1) ^ 4) = 2 * m ^ 2 * (m - 1) ^ 2 * (2 * m - 3) * (2 * m + 3) := by
    unfold cpo; exact div_mul_cancel₀ _ (mul_ne_zero (pow_ne_zero 2 h1) (pow_ne_zero 4 h3))
  have km : m * m⁻¹ = 1 := mul_inv_cancel₀ h4
  rw [eq_div_iff hd]
  simp only [alo, beo, quad0P, linhP]
  linear_combination (S*(2*S - 1)/2) * kB + (S*(S - 1)*(cpo m - 2)*(m - 2)*(2*m - 1)^4/2) * kb + (S*(S - 1)) * kc

